// Rio GUI for the o9irc 9P view. It never opens an IRC socket.
import "draw.o9";
import "process.o9";
import "string.o9";
import "uiio.o9";



// A timer wakes event() so the 9P view can be refreshed between mouse events.
function IrcUiStartTimerRaw() int64 {
    use { event }
    int64 out;
    c {
        out = etimer(0, 100);
    }
    return out;
}

// The index is key<TAB>display-name<NL>. Selection belongs to this GUI;
// neither the IRC actor nor another attached GUI changes it.
function IrcUiIndexFieldRaw(string index, int64 row, bool name) string {
    string out;
    c {
        char *p, *end, *tab, *nl;
        vlong i, n;

        out = o9_string_from_c("");
        p = o9_string_data(index);
        end = p + o9_string_len(index);
        for(i = 0; i <= row && p < end; i++){
            nl = memchr(p, '\n', end-p);
            if(nl == nil)
                nl = end;
            if(i == row){
                tab = memchr(p, '\t', nl-p);
                if(tab != nil){
                    if(name){
                        p = tab+1;
                        n = nl-p;
                    }else
                        n = tab-p;
                    o9_string_release(out);
                    out = o9_string_new(p, n);
                }
            }
            p = nl+1;
        }
    }
    return out;
}

// Keep the identity distinct from the controls without changing Rio's
// familiar text and menu behavior. Fall back to the active font if needed.
function IrcUiTitleRaw(int64 canvas, string label, int64 x, int64 y) int64 {
    use { draw }
    int64 out;
    c {
        static Font *heading;
        Image *ink;
        char *text;

        out = 0;
        if(canvas > 0 && display != nil && screen != nil){
            if(heading == nil)
                heading = openfont(display,
                    "/lib/font/bit/lucidasans/boldunicode.13.font");
            ink = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1,
                0xffffffff);
            text = o9_string_cstr(label);
            if(ink != nil && text != nil){
                string(screen, Pt(screen->r.min.x+x, screen->r.min.y+y),
                    ink, ZP, heading != nil ? heading : font, text);
                out = 1;
            }
            free(text);
            if(ink != nil)
                freeimage(ink);
        }
    }
    return out;
}

function IrcUiFieldEditRaw(string value, int64 key, int64 maximum) string {
    string out;
    c {
        char *p;
        vlong n;

        p = o9_string_data(value);
        n = o9_string_len(value);
        out = o9_string_new(p, n);
        if((key == 8 || key == 127) && n > 0){
            o9_string_release(out);
            out = o9_string_new(p, n-1);
        }else if(key >= 32 && key <= 126 && n < maximum){
            char buf[256];
            if(n < sizeof buf-1){
                memmove(buf, p, n);
                buf[n] = key;
                o9_string_release(out);
                out = o9_string_new(buf, n+1);
            }
        }
    }
    return out;
}

function IrcUiClippedTextRaw(int64 canvas, string value, int64 x, int64 y,
                             int64 width, int64 color) int64 {
    use { draw }
    int64 out;
    c {
        char *text;
        Image *ink;
        Rectangle oldclip, clip;
        vlong n, start;

        out = 0;
        if(canvas > 0 && display != nil && screen != nil && font != nil && width > 0){
            text = o9_string_cstr(value);
            if(text != nil){
                n = strlen(text);
                start = 0;
                while(start < n && stringwidth(font, text+start) > width-8)
                    start++;
                ink = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1,
                    ((ulong)color << 8) | 0xff);
                oldclip = screen->clipr;
                clip = Rect(screen->r.min.x+x, screen->r.min.y+y,
                    screen->r.min.x+x+width, screen->r.min.y+y+font->height);
                if(ink != nil && rectclip(&clip, oldclip)){
                    replclipr(screen, 0, clip);
                    string(screen, Pt(screen->r.min.x+x, screen->r.min.y+y),
                        ink, ZP, font, text+start);
                    replclipr(screen, 0, oldclip);
                    out = 1;
                }
                if(ink != nil) freeimage(ink);
                free(text);
            }
        }
    }
    return out;
}

function IrcUiProfileCommandRaw(bool connectNow, string host, string port,
                                string nick, string channel, string realName,
                                bool tls, string trustPath) string {
    string out;
    c {
        char buf[900];
        int n;

        n = snprint(buf, sizeof buf, "%s\t%.*s\t%.*s\t%.*s\t%.*s\t%.*s\t%s\t%.*s\n",
            connectNow ? "connect" : "profile",
            (int)o9_string_len(host), o9_string_data(host),
            (int)o9_string_len(port), o9_string_data(port),
            (int)o9_string_len(nick), o9_string_data(nick),
            (int)o9_string_len(channel), o9_string_data(channel),
            (int)o9_string_len(realName), o9_string_data(realName),
            tls ? "tls" : "tcp",
            (int)o9_string_len(trustPath), o9_string_data(trustPath));
        out = n < sizeof buf-1 ? o9_string_new(buf, n) : o9_string_from_c("");
    }
    return out;
}

function IrcUiPanel(int64 canvas, int64 x, int64 y, int64 width, int64 height, int64 color) int64 {
    use { draw }
    int64 out;
    c {
        Image *img;
        Rectangle r;
        ulong c;

        out = 0;
        if(canvas > 0 && display != nil && screen != nil && width > 0 && height > 0){
            c = (ulong)color;
            if((c & 0xFF000000UL) == 0)
                c = ((c & 0xFFFFFFUL) << 8) | 0xFFUL;
            r = Rect(screen->r.min.x + x, screen->r.min.y + y,
                screen->r.min.x + x + width, screen->r.min.y + y + height);
            img = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, c);
            if(img != nil){
                draw(screen, r, img, nil, ZP);
                freeimage(img);
                out = 1;
            }
            img = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1,
                0xb7c4d2ffUL);
            if(img != nil){
                border(screen, r, 1, img, ZP);
                freeimage(img);
                out = 1;
            }
        }
    }
    return out;
}


// One layout pass supplies painting, selection, hit testing, and scrollback.
// Rows are byte ranges in the original 9P text; wrapping never changes what
// copying to /dev/snarf returns.  Mode 4 paints the selection and the text in
// a single pass; flushNow flushes the display at the end of that pass.
function IrcUiChatRaw(int64 canvas, string value, int64 width, int64 height,
                      int64 back, int64 anchor, int64 cursor,
                      int64 x, int64 y, int64 mode, bool flushNow) int64 {
    use { draw }
    int64 out;
    c {
        char *text, *nl;
        Image *ink, *sel;
        Rune r;
        vlong length, pos, lineend, start, end, space, count, first, target;
        vlong lo, hi, a, b, offset;
        int pass, rows, limit, used, n, rw, row, px, x1, x2, yy;

        out = 0;
        text = o9_string_data(value);
        length = o9_string_len(value);
        if(text != nil && length > 0 && font != nil && width > 16){
            rows = (height - 12) / 18;
            if(rows < 1)
                rows = 1;
            limit = width - 16;
            ink = nil;
            sel = nil;
            if((mode == 1 || mode == 4) && canvas > 0 && display != nil &&
               screen != nil && anchor >= 0 && cursor >= 0 && anchor != cursor)
                sel = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xbad7ffff);
            if((mode == 2 || mode == 4) && canvas > 0 && display != nil && screen != nil)
                ink = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x172536ff);
            lo = anchor < cursor ? anchor : cursor;
            hi = anchor > cursor ? anchor : cursor;
            count = 0;
            first = 0;
            target = 0;
            for(pass = 0; pass < (mode == 0 ? 1 : 2); pass++){
                if(pass == 1){
                    first = count > rows ? count - rows - back : 0;
                    if(first < 0)
                        first = 0;
                    row = (y - 118) / 18;
                    if(y < 118)
                        row = 0;
                    if(row >= rows)
                        row = rows - 1;
                    target = first + row;
                    if(target >= count)
                        target = count - 1;
                    count = 0;
                }
                pos = 0;
                while(pos < length){
                    nl = memchr(text + pos, '\n', length - pos);
                    lineend = nl != nil ? nl - text : length;
                    start = pos;
                    do{
                        end = start;
                        space = -1;
                        used = 0;
                        while(end < lineend){
                            n = chartorune(&r, text + end);
                            if(n < 1 || n > lineend - end){
                                n = 1;
                                r = Runeerror;
                            }
                            rw = runestringnwidth(font, &r, 1);
                            if(used + rw > limit && end > start)
                                break;
                            used += rw;
                            end += n;
                            if(r == ' ' || r == '\t')
                                space = end;
                            if(used > limit)
                                break;
                        }
                        if(end < lineend && space > start)
                            end = space;
                        if(pass == 1 && count >= first && count < first + rows){
                            yy = 118 + (count - first) * 18;
                            if((mode == 1 || mode == 4) && sel != nil){
                                a = lo > start ? lo : start;
                                b = hi < end ? hi : end;
                                if(a < start)
                                    a = start;
                                if(a > end)
                                    a = end;
                                if(b > end)
                                    b = end;
                                if(b > a || (nl != nil && end == lineend &&
                                   hi > lineend && lo <= lineend)){
                                    x1 = 188 + stringnwidth(font, text + start, a - start);
                                    x2 = 188 + stringnwidth(font, text + start, b - start);
                                    if(nl != nil && end == lineend && hi > lineend)
                                        x2 += 5;
                                    if(x2 <= x1)
                                        x2 = x1 + 5;
                                    if(x1 > 180 + width - 8)
                                        x1 = 180 + width - 8;
                                    if(x2 > 180 + width - 8)
                                        x2 = 180 + width - 8;
                                    if(x2 > x1)
                                        draw(screen, Rect(screen->r.min.x+x1,
                                            screen->r.min.y+yy, screen->r.min.x+x2,
                                            screen->r.min.y+yy+16), sel, nil, ZP);
                                }
                            }
                            if((mode == 2 || mode == 4) && ink != nil){
                                stringn(screen, Pt(screen->r.min.x+188,
                                    screen->r.min.y+yy), ink, ZP, font,
                                    text + start, end - start);
                            }
                            if(mode == 3 && count == target){
                                px = 0;
                                offset = start;
                                while(offset < end){
                                    n = chartorune(&r, text + offset);
                                    if(n < 1 || n > end - offset){
                                        n = 1;
                                        r = Runeerror;
                                    }
                                    rw = runestringnwidth(font, &r, 1);
                                    if(x - 188 < px + rw / 2)
                                        break;
                                    px += rw;
                                    offset += n;
                                }
                                out = offset;
                            }
                        }
                        count++;
                        start = end;
                    }while(start < lineend);
                    pos = nl != nil ? lineend + 1 : length;
                }
            }
            if(mode == 0)
                out = count;
            if(ink != nil)
                freeimage(ink);
            if(sel != nil)
                freeimage(sel);
        }
        if(mode == 4 && display != nil){
            if(flushNow)
                flushimage(display, 1);
            out = 1;
        }
    }
    return out;
}

// Cached visual-row index for the chat transcript.  Selection drags and
// wheel max-back use this instead of re-laying out the whole transcript.
// mode 0: number of visual rows; mode 3: byte offset at (x,y).
function IrcUiChatIndexRaw(string value, int64 width, int64 height,
                           int64 back, int64 x, int64 y, int64 mode) int64 {
    use { draw }
    int64 out;
    c {
        struct ChatRow { vlong start, end; };
        static struct {
            QLock lock;
            O9String *value;
            char *text;
            vlong len;
            int width, height;
            Font *font;
            vlong n, cap;
            struct ChatRow *rows;
        } idx;
        char *text, *nl;
        vlong length, pos, lineend, start, end2, space, used;
        vlong rows, first, target, offset, px;
        int limit, rw, k;
        Rune r;

        out = 0;
        text = o9_string_data(value);
        length = o9_string_len(value);
        if(text == nil || font == nil || width <= 16 || height <= 12){
            out = 0;
            goto chat_index_done;
        }

        qlock(&idx.lock);
        if(idx.value != value || idx.text != text || idx.len != length ||
           idx.width != width || idx.height != height || idx.font != font){
            // Retain the source string, not just its data pointer.  Without
            // this, freeing one transcript and allocating the next at the same
            // address with the same length would reuse stale row offsets.
            if(idx.value != value){
                o9_string_release(idx.value);
                idx.value = o9_string_retain(value);
            }
            idx.text = text;
            idx.len = length;
            idx.width = width;
            idx.height = height;
            idx.font = font;
            idx.n = 0;
            limit = width - 16;
            pos = 0;
            while(pos < length){
                nl = memchr(text + pos, '\n', length - pos);
                lineend = nl != nil ? nl - text : length;
                start = pos;
                do{
                    end2 = start;
                    space = -1;
                    used = 0;
                    while(end2 < lineend){
                        k = chartorune(&r, text + end2);
                        if(k < 1 || k > lineend - end2){
                            k = 1;
                            r = Runeerror;
                        }
                        rw = runestringnwidth(font, &r, 1);
                        if(used + rw > limit && end2 > start)
                            break;
                        used += rw;
                        end2 += k;
                        if(r == ' ' || r == '\t')
                            space = end2;
                        if(used > limit)
                            break;
                    }
                    if(end2 < lineend && space > start)
                        end2 = space;
                    if(idx.n == idx.cap){
                        struct ChatRow *nr;
                        vlong newcap;
                        newcap = idx.cap ? idx.cap * 2 : 256;
                        nr = realloc(idx.rows, newcap * sizeof *nr);
                        if(nr == nil){
                            // Invalidate the key so a later call retries the
                            // build instead of serving a zero-row cache.
                            o9_string_release(idx.value);
                            idx.value = nil;
                            idx.text = nil;
                            idx.len = -1;
                            idx.n = 0;
                            qunlock(&idx.lock);
                            out = 0;
                            goto chat_index_done;
                        }
                        idx.rows = nr;
                        idx.cap = newcap;
                    }
                    idx.rows[idx.n].start = start;
                    idx.rows[idx.n].end = end2;
                    idx.n++;
                    start = end2;
                }while(start < lineend);
                pos = nl != nil ? lineend + 1 : length;
            }
        }

        if(mode == 0){
            out = idx.n;
            qunlock(&idx.lock);
            goto chat_index_done;
        }

        rows = (height - 12) / 18;
        if(rows < 1)
            rows = 1;
        first = idx.n > rows ? idx.n - rows - back : 0;
        if(first < 0)
            first = 0;
        target = (y - 118) / 18;
        if(y < 118)
            target = 0;
        if(target < 0)
            target = 0;
        target = first + target;
        if(target >= idx.n)
            target = idx.n - 1;
        if(target < 0){
            qunlock(&idx.lock);
            out = 0;
            goto chat_index_done;
        }

        start = idx.rows[target].start;
        end2 = idx.rows[target].end;
        px = 0;
        offset = start;
        while(offset < end2){
            k = chartorune(&r, text + offset);
            if(k < 1 || k > end2 - offset){
                k = 1;
                r = Runeerror;
            }
            rw = runestringnwidth(font, &r, 1);
            if(x - 188 < px + rw / 2)
                break;
            px += rw;
            offset += k;
        }
        out = offset;
        qunlock(&idx.lock);
chat_index_done:
        ;
    }
    return out;
}

function IrcUiMaxBack(string value, int64 width, int64 height) int64 {
    Task<int64> counted = spawn IrcUiChatIndexRaw(value, width - 340,
                                                  height - 184, 0, 0, 0, 0);
    int64 count = counted.await();
    int64 rows = (height - 196) / 18;
    if(rows < 1) { rows = 1; }
    c { o9_task_close(counted); }
    if(count > rows) { return count - rows; }
    return 0;
}

// Map a mouse position in the chat pane to a byte boundary in the plain-text
// 9P transcript. The same layout routine paints the text and selection.
function IrcUiHitChatRaw(string value, int64 width, int64 height, int64 back,
                         int64 x, int64 y) int64 {
    Task<int64> hit = spawn IrcUiChatIndexRaw(value, width, height, back,
                                             x, y, 3);
    int64 result = hit.await();
    c { o9_task_close(hit); }
    return result;
}

// Draw the static chrome, room/topic labels, conversation tree, nick list,
// and input panel in one actor.  Bit 0 of the result says the room label is
// scrolling; bit 1 the topic label.
function IrcUiFrameRaw(int64 canvas, int64 width, int64 height,
                       string connection, bool statusView,
                       string room, string topic, int64 tick,
                       string conversations, string selectedKey, string nicks,
                       string input) int64 {
    use { draw }
    int64 out;
    c {
        int chatHeight, nickX;

        out = 0;
        if(canvas <= 0 || display == nil || screen == nil || font == nil)
            goto frame_done;
        chatHeight = height - 184;
        nickX = width - 154;

        /* static chrome */
        {
            Image *img;
            Rectangle r;
            ulong c;
            char *status;
            int tabX, statusColor;

            status = o9_string_cstr(connection);
            if(status != nil){
                vlong slen = strlen(status);
                while(slen > 0 && (status[slen-1] == '\n' ||
                      status[slen-1] == '\r' || status[slen-1] == '\t' ||
                      status[slen-1] == ' '))
                    status[--slen] = 0;
            }
            tabX = statusView ? 10 : 104;
            statusColor = statusView ? 0xd5e7fa : 0xf7f9fc;

#define O9COL(v) (ulong)(((v) & 0xFF000000UL) ? (v) : ((((ulong)(v)) << 8) | 0xFFUL))
#define O9FILL(X,Y,W,H,V) do { \
            c = O9COL(V); \
            r = Rect(screen->r.min.x+(X), screen->r.min.y+(Y), \
                     screen->r.min.x+(X)+(W), screen->r.min.y+(Y)+(H)); \
            img = allocimage(display, Rect(0,0,1,1), screen->chan, 1, c); \
            if(img != nil){ draw(screen, r, img, nil, ZP); freeimage(img); } \
        } while(0)
#define O9PANEL(X,Y,W,H,V) do { \
            O9FILL(X,Y,W,H,V); \
            c = 0xb7c4d2ffUL; \
            r = Rect(screen->r.min.x+(X), screen->r.min.y+(Y), \
                     screen->r.min.x+(X)+(W), screen->r.min.y+(Y)+(H)); \
            img = allocimage(display, Rect(0,0,1,1), screen->chan, 1, c); \
            if(img != nil){ border(screen, r, 1, img, ZP); freeimage(img); } \
        } while(0)
#define O9TEXT(X,Y,S,V) do { \
            c = O9COL(V); \
            img = allocimage(display, Rect(0,0,1,1), screen->chan, 1, c); \
            if(img != nil){ string(screen, Pt(screen->r.min.x+(X), screen->r.min.y+(Y)), \
                                   img, ZP, font, (S)); freeimage(img); } \
        } while(0)

            O9FILL(0, 0, width, height, 0xe9eef3);
            O9PANEL(6, 6, width-12, 28, 0x203149);
            O9TEXT(15, 7, "o9irc", 0xffffff);
            O9FILL(94, 10, 166, 20, 0x3a5c83);
            O9TEXT(104, 11, "Menu  (button 3)", 0xffffff);
            O9TEXT(278, 11, "Drag to select   Button 2 copies   Wheel / PgUp / PgDn for history", 0xe4edf7);
            O9PANEL(6, 40, width-12, 28, 0xe3ebf4);
            O9FILL(tabX, 42, 82, 24, 0xffffff);
            O9TEXT(16, 46, "Status", 0x173a64);
            O9PANEL(6, 76, 166, height-110, 0xf7f9fc);
            O9TEXT(16, 86, "Network", 0x243950);
            O9FILL(26, 105, 138, 22, statusColor);
            O9TEXT(16, 108, "  Status", 0x243950);
            O9TEXT(16, 134, "  Channels", 0x243950);
            O9PANEL(180, 76, width-340, 30, 0xf2f6fa);
            O9PANEL(180, 112, width-340, height-184, 0xffffff);
            O9PANEL(width-154, 76, 142, 30, 0xf2f6fa);
            O9TEXT(width-146, 83, "Nicks", 0x20344f);
            O9PANEL(width-154, 112, 142, height-184, 0xf9fbfe);
            O9PANEL(6, height-26, width-12, 20, 0xe3ebf4);
            if(status != nil){
                char footer[256];
                snprint(footer, sizeof footer, "o9irc  |  %s", status);
                O9TEXT(14, height-23, footer, 0x334860);
                free(status);
            }
#undef O9TEXT
#undef O9PANEL
#undef O9FILL
#undef O9COL
        }

        /* room and topic labels */
        {
            struct {
                char *text;
                vlong len;
                int x, y, w;
                ulong color;
            } lab[2];
            Image *ink;
            Rune r;
            vlong total, start, maxstart, phase, cycle, i, offset, end, used;
            int k, n, prefix, rw, chatWidth;
            char *s;

            chatWidth = width - 356;
            if(chatWidth < 1)
                chatWidth = 1;
            s = o9_string_data(room);
            lab[0].text = s;
            lab[0].len = s != nil ? o9_string_len(room) : 0;
            lab[0].x = 112;
            lab[0].y = 46;
            lab[0].w = 66;
            lab[0].color = 0x173a64ffUL;
            s = o9_string_data(topic);
            lab[1].text = s;
            lab[1].len = s != nil ? o9_string_len(topic) : 0;
            lab[1].x = 188;
            lab[1].y = 83;
            lab[1].w = chatWidth;
            lab[1].color = 0x20344fffUL;
            for(k = 0; k < 2; k++){
                if(lab[k].text == nil || lab[k].len <= 0 || lab[k].w <= 0)
                    continue;
                total = stringnwidth(font, lab[k].text, lab[k].len);
                start = 0;
                if(total > lab[k].w){
                    out |= 1 << k;
                    maxstart = 0;
                    prefix = 0;
                    offset = 0;
                    while(offset < lab[k].len && total - prefix > lab[k].w){
                        n = chartorune(&r, lab[k].text + offset);
                        if(n < 1 || n > lab[k].len - offset){
                            n = 1;
                            r = Runeerror;
                        }
                        prefix += runestringnwidth(font, &r, 1);
                        offset += n;
                        maxstart++;
                    }
                    cycle = 2 * maxstart + 8;
                    phase = tick % cycle;
                    if(phase < 4)
                        start = 0;
                    else if(phase < 4 + maxstart)
                        start = phase - 3;
                    else if(phase < 8 + maxstart)
                        start = maxstart;
                    else
                        start = 2 * maxstart + 7 - phase;
                }
                offset = 0;
                for(i = 0; i < start && offset < lab[k].len; i++){
                    n = chartorune(&r, lab[k].text + offset);
                    if(n < 1 || n > lab[k].len - offset)
                        n = 1;
                    offset += n;
                }
                end = offset;
                used = 0;
                while(end < lab[k].len){
                    n = chartorune(&r, lab[k].text + end);
                    if(n < 1 || n > lab[k].len - end){
                        n = 1;
                        r = Runeerror;
                    }
                    rw = runestringnwidth(font, &r, 1);
                    if(used + rw > lab[k].w)
                        break;
                    used += rw;
                    end += n;
                }
                ink = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1,
                    lab[k].color);
                if(ink != nil){
                    stringn(screen, Pt(screen->r.min.x + lab[k].x,
                        screen->r.min.y + lab[k].y), ink, ZP, font,
                        lab[k].text + offset, end - offset);
                    freeimage(ink);
                }
            }
        }

        /* conversation tree */
        {
            char *p, *end, *nl, *tab, *name, *prefix;
            char label[128];
            Image *ink, *highlight;
            Rectangle clip, oldclip;
            Rune rune;
            int row, y, n, namelen, step, abbreviated, prefixwidth, maxwidth;

            ink = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x243950ff);
            highlight = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xd5e7faff);
            p = o9_string_data(conversations);
            end = p + (p != nil ? o9_string_len(conversations) : 0);
            row = 0;
            while(p < end && row < 64){
                y = 159 + row*22;
                if(y > height - 68)
                    break;
                nl = memchr(p, '\n', end-p);
                if(nl == nil)
                    nl = end;
                tab = memchr(p, '\t', nl-p);
                if(tab != nil){
                    if(highlight != nil && o9_string_len(selectedKey) == tab-p &&
                       memcmp(p, o9_string_data(selectedKey), tab-p) == 0)
                        draw(screen, Rect(screen->r.min.x+26, screen->r.min.y+y-3,
                            screen->r.min.x+164, screen->r.min.y+y+19), highlight, nil, ZP);
                    name = tab+1;
                    namelen = nl-name;
                    prefix = tab-p >= 6 && memcmp(p, "users/", 6) == 0 ? "@" : "";
                    prefixwidth = stringwidth(font, prefix);
                    maxwidth = 164-34-4;
                    n = 0;
                    while(n < namelen){
                        step = chartorune(&rune, name+n);
                        if(step < 1 || n+step > namelen ||
                           n+step >= sizeof label-4 ||
                           prefixwidth+stringnwidth(font, name, n+step) > maxwidth)
                            break;
                        n += step;
                    }
                    abbreviated = n < namelen;
                    if(abbreviated)
                        while(n > 0 && prefixwidth+stringnwidth(font, name, n)+
                              stringwidth(font, "...") > maxwidth){
                            n--;
                            while(n > 0 && ((uchar)name[n] & 0xc0) == 0x80)
                                n--;
                        }
                    snprint(label, sizeof label, "%s%.*s%s", prefix, n, name,
                        abbreviated ? "..." : "");
                    if(ink != nil){
                        oldclip = screen->clipr;
                        clip = Rect(screen->r.min.x+34, screen->r.min.y+y,
                            screen->r.min.x+164, screen->r.min.y+y+font->height);
                        if(rectclip(&clip, oldclip)){
                            replclipr(screen, 0, clip);
                            string(screen, Pt(screen->r.min.x+34, screen->r.min.y+y),
                                ink, ZP, font, label);
                            replclipr(screen, 0, oldclip);
                        }
                    }
                }
                p = nl+1;
                row++;
            }
            if(ink != nil)
                freeimage(ink);
            if(highlight != nil)
                freeimage(highlight);
        }

        /* nick list */
        {
            char *text, *nl;
            Image *img;
            vlong length, count, i, start, end, first, last, lineLen;
            int rows, maxChars;
            ulong c;

            text = o9_string_data(nicks);
            length = text != nil ? o9_string_len(nicks) : 0;
            count = 0;
            for(i = 0; i < length; i++)
                if(text[i] == '\n')
                    count++;
            if(length > 0 && text[length-1] != '\n')
                count++;
            rows = (chatHeight - 12) / 18;
            if(rows < 1)
                rows = 1;
            first = 0;
            last = first + rows;
            if(last > count)
                last = count;
            maxChars = (142 - 16) / 8;
            if(maxChars < 1)
                maxChars = 1;
            c = 0x17253600UL | 0xFFUL;
            img = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, c);
            if(img != nil){
                start = 0;
                for(i = 0; start < length && i < last; i++){
                    nl = memchr(text + start, '\n', length - start);
                    end = nl != nil ? nl - text : length;
                    lineLen = end - start;
                    if(lineLen > maxChars)
                        lineLen = maxChars;
                    if(i >= first)
                        stringn(screen, Pt(screen->r.min.x + nickX + 8,
                            screen->r.min.y + 118 + (i - first) * 18),
                            img, ZP, font, text + start, lineLen);
                    start = nl != nil ? end + 1 : length;
                }
                freeimage(img);
            }
        }

        /* input panel and the visible tail of the edit buffer */
        if(width > 186 && height >= 64){
            char *text;
            Image *img, *ink;
            Rectangle r;
            vlong len, maxchars, start, used;

            text = o9_string_data(input);
            len = text != nil ? o9_string_len(input) : 0;
            maxchars = (width - 204) / 8;
            if(maxchars < 1)
                maxchars = 1;
            start = 0;
            if(len + 1 > maxchars)
                start = len + 1 - maxchars;
            r = Rect(screen->r.min.x + 180, screen->r.min.y + height - 64,
                screen->r.min.x + width - 6, screen->r.min.y + height - 32);
            img = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xffffffffUL);
            if(img != nil){
                draw(screen, r, img, nil, ZP);
                freeimage(img);
            }
            img = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xb7c4d2ffUL);
            if(img != nil){
                border(screen, r, 1, img, ZP);
                freeimage(img);
            }
            ink = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x172536ffUL);
            if(ink != nil){
                used = 0;
                if(start < len){
                    stringn(screen, Pt(screen->r.min.x + 188,
                        screen->r.min.y + height - 57), ink, ZP, font,
                        text + start, len - start);
                    used = stringnwidth(font, text + start, len - start);
                }
                stringn(screen, Pt(screen->r.min.x + 188 + used,
                    screen->r.min.y + height - 57), ink, ZP, font, "|", 1);
                freeimage(ink);
            }
        }
frame_done:
        ;
    }
    return out;
}

function IrcUiCopySelectionRaw(string value, int64 anchor, int64 cursor) int64 {
    int64 out;
    c {
        char *text;
        vlong lo, hi, pos, length;
        int fd, n, chunk;

        out = 0;
        text = o9_string_data(value);
        length = o9_string_len(value);
        lo = anchor < cursor ? anchor : cursor;
        hi = anchor > cursor ? anchor : cursor;
        if(text != nil && lo >= 0 && hi > lo && hi <= length){
            fd = open("/dev/snarf", OWRITE|OTRUNC);
            if(fd >= 0){
                pos = lo;
                while(pos < hi){
                    chunk = hi - pos;
                    if(chunk > 8192)
                        chunk = 8192;
                    n = write(fd, text + pos, chunk);
                    if(n <= 0)
                        break;
                    pos += n;
                }
                out = pos == hi;
                close(fd);
            }
        }
    }
    return out;
}

// The timer only moves two labels. Redrawing the whole transcript on each
// animation step creates unnecessary libdraw traffic and short-lived actors.
// Scrolling-label animation: one actor paints the tab/bar fills, both labels,
// and the flush.  Bit 0 of the result says the room label is scrolling; bit 1
// the topic label.
function IrcUiLabelFrameRaw(int64 canvas, int64 width, string channel,
                            string topic, bool statusView, int64 scrollBack,
                            int64 tick) int64 {
    use { draw }
    int64 out;
    c {
        struct {
            char *text;
            vlong len;
            int x, y, w;
            ulong color;
        } lab[2];
        char tbuf[1024];
        char *s;
        Image *img;
        Rectangle r;
        ulong c;
        Rune rn;
        vlong n, b, e, total, start, maxstart, phase, cycle, i, offset, end, used;
        int k, nn, prefix, rw, chatWidth, keep;

        out = 0;
        if(canvas <= 0 || display == nil || screen == nil || font == nil)
            goto label_frame_done;
        chatWidth = width - 340;
        if(chatWidth < 1)
            chatWidth = 1;

        s = o9_string_data(channel);
        n = s != nil ? o9_string_len(channel) : 0;
        b = 0;
        while(b < n && (s[b] == ' ' || s[b] == '\t' ||
                        s[b] == '\n' || s[b] == '\r'))
            b++;
        e = n;
        while(e > b && (s[e-1] == ' ' || s[e-1] == '\t' ||
                        s[e-1] == '\n' || s[e-1] == '\r'))
            e--;
        lab[0].text = s != nil ? s + b : "";
        lab[0].len = e - b;
        lab[0].x = 112;
        lab[0].y = 46;
        lab[0].w = 66;
        lab[0].color = 0x173a64ffUL;

        s = o9_string_data(topic);
        n = s != nil ? o9_string_len(topic) : 0;
        b = 0;
        while(b < n && (s[b] == ' ' || s[b] == '\t' ||
                        s[b] == '\n' || s[b] == '\r'))
            b++;
        e = n;
        while(e > b && (s[e-1] == ' ' || s[e-1] == '\t' ||
                        s[e-1] == '\n' || s[e-1] == '\r'))
            e--;
        keep = (int)(e - b);
        if(keep > (int)sizeof tbuf - 32)
            keep = sizeof tbuf - 32;
        if(statusView && scrollBack > 0)
            snprint(tbuf, sizeof tbuf, "Network status and server replies  [history]");
        else if(statusView)
            snprint(tbuf, sizeof tbuf, "Network status and server replies");
        else if(scrollBack > 0)
            snprint(tbuf, sizeof tbuf, "Topic: %.*s  [history]", keep,
                s != nil ? s + b : "");
        else
            snprint(tbuf, sizeof tbuf, "Topic: %.*s", keep,
                s != nil ? s + b : "");
        lab[1].text = tbuf;
        lab[1].len = strlen(tbuf);
        lab[1].x = 188;
        lab[1].y = 83;
        lab[1].w = chatWidth - 16;
        lab[1].color = 0x20344fffUL;

#define LFILL(X,Y,W,H,V) do { \
            c = ((ulong)(V) << 8) | 0xFFUL; \
            r = Rect(screen->r.min.x+(X), screen->r.min.y+(Y), \
                     screen->r.min.x+(X)+(W), screen->r.min.y+(Y)+(H)); \
            img = allocimage(display, Rect(0,0,1,1), screen->chan, 1, c); \
            if(img != nil){ draw(screen, r, img, nil, ZP); freeimage(img); } \
        } while(0)
        LFILL(104, 42, 82, 24, statusView ? 0xe3ebf4 : 0xffffff);
        LFILL(182, 78, chatWidth - 4, 26, 0xf2f6fa);
#undef LFILL

        for(k = 0; k < 2; k++){
            if(lab[k].text == nil || lab[k].len <= 0 || lab[k].w <= 0)
                continue;
            total = stringnwidth(font, lab[k].text, lab[k].len);
            start = 0;
            if(total > lab[k].w){
                out |= 1 << k;
                maxstart = 0;
                prefix = 0;
                offset = 0;
                while(offset < lab[k].len && total - prefix > lab[k].w){
                    nn = chartorune(&rn, lab[k].text + offset);
                    if(nn < 1 || nn > lab[k].len - offset){
                        nn = 1;
                        rn = Runeerror;
                    }
                    prefix += runestringnwidth(font, &rn, 1);
                    offset += nn;
                    maxstart++;
                }
                cycle = 2 * maxstart + 8;
                phase = tick % cycle;
                if(phase < 4)
                    start = 0;
                else if(phase < 4 + maxstart)
                    start = phase - 3;
                else if(phase < 8 + maxstart)
                    start = maxstart;
                else
                    start = 2 * maxstart + 7 - phase;
            }
            offset = 0;
            for(i = 0; i < start && offset < lab[k].len; i++){
                nn = chartorune(&rn, lab[k].text + offset);
                if(nn < 1 || nn > lab[k].len - offset)
                    nn = 1;
                offset += nn;
            }
            end = offset;
            used = 0;
            while(end < lab[k].len){
                nn = chartorune(&rn, lab[k].text + end);
                if(nn < 1 || nn > lab[k].len - end){
                    nn = 1;
                    rn = Runeerror;
                }
                rw = runestringnwidth(font, &rn, 1);
                if(used + rw > lab[k].w)
                    break;
                used += rw;
                end += nn;
            }
            img = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1,
                lab[k].color);
            if(img != nil){
                stringn(screen, Pt(screen->r.min.x + lab[k].x,
                    screen->r.min.y + lab[k].y), img, ZP, font,
                    lab[k].text + offset, end - offset);
                freeimage(img);
            }
        }
        flushimage(display, 1);
label_frame_done:
        ;
    }
    return out;
}

function IrcUiPaintLabels(int64 canvas, int64 width, string channel,
                          string topic, bool statusView, int64 scrollBack,
                          int64 labelTick) int64 {
    Task<int64> painted = spawn IrcUiLabelFrameRaw(canvas, width, channel, topic,
                                                    statusView, scrollBack, labelTick);
    int64 result = painted.await();
    c { o9_task_close(painted); }
    return result;
}

// Incremental input update: one actor paints the input panel, the visible
// tail of the edit buffer, and the caret.  The full frame path draws the input
// inside IrcUiFrameRaw so a repaint needs only two actors.
function IrcUiPaintInput(int64 canvas, int64 width, int64 height, string input, bool flushNow) int64 {
    use { draw }
    int64 out;
    c {
        char *text;
        Image *img, *ink;
        Rectangle r;
        vlong len, maxchars, start, used;

        out = 0;
        if(canvas <= 0 || display == nil || screen == nil || font == nil ||
           width <= 186 || height < 64)
            goto input_done;

        r = Rect(screen->r.min.x + 180, screen->r.min.y + height - 64,
            screen->r.min.x + width - 6, screen->r.min.y + height - 32);
        img = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xffffffffUL);
        if(img != nil){
            draw(screen, r, img, nil, ZP);
            freeimage(img);
        }
        img = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xb7c4d2ffUL);
        if(img != nil){
            border(screen, r, 1, img, ZP);
            freeimage(img);
        }

        text = o9_string_data(input);
        len = text != nil ? o9_string_len(input) : 0;
        maxchars = (width - 204) / 8;
        if(maxchars < 1)
            maxchars = 1;
        start = 0;
        if(len + 1 > maxchars)
            start = len + 1 - maxchars;
        ink = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x172536ffUL);
        if(ink != nil){
            used = 0;
            if(start < len){
                stringn(screen, Pt(screen->r.min.x + 188,
                    screen->r.min.y + height - 57), ink, ZP, font,
                    text + start, len - start);
                used = stringnwidth(font, text + start, len - start);
            }
            stringn(screen, Pt(screen->r.min.x + 188 + used,
                screen->r.min.y + height - 57), ink, ZP, font, "|", 1);
            freeimage(ink);
        }
        out = 1;
        if(flushNow)
            flushimage(display, 1);
input_done:
        ;
    }
    return out;
}

function IrcUiSetupRow(int64 canvas, int64 x, int64 y, int64 width,
                       string label, string value, bool focused) int64 {
    int64 background = 0xffffff;
    if(focused) { background = 0xe7f3ff; }
    Task<int64> box = spawn IrcUiPanel(canvas, x, y, width, 38, background);
    box.take();
    Task<int64> title = spawn DrawCanvasTextRaw(canvas, label, x+10, y+10, 0x203149);
    title.take();
    Task<int64> content = spawn IrcUiClippedTextRaw(canvas, value, x+145, y+10,
        width-158, 0x162b45);
    content.take();
    return 1;
}

function IrcUiPaintSetup(int64 canvas, int64 width, int64 height,
                         string host, string port, string nick, string channel,
                         string realName, bool tls, string trustPath,
                         int64 focus, string error) int64 {
    int64 x = (width-580)/2;
    int64 y = (height-492)/2;
    Task<int64> panel = spawn IrcUiPanel(canvas, x, y, 580, 492, 0xf7f9fc);
    panel.take();
    Task<int64> heading = spawn DrawCanvasFillRectRaw(canvas, x+1, y+1, 578, 48, 0x203149);
    heading.take();
    Task<int64> title = spawn IrcUiTitleRaw(canvas, "Connection setup", x+16, y+11);
    title.take();
    Task<int64> hint = spawn DrawCanvasTextRaw(canvas,
        "Nick and full name are visible to others.",
        x+16, y+55, 0x465e78);
    hint.take();
    Task<int64> serverRow = spawn IrcUiSetupRow(canvas, x+16, y+81, 548,
        "Server", host, focus == 0);
    serverRow.take();
    Task<int64> portRow = spawn IrcUiSetupRow(canvas, x+16, y+128, 548,
        "Port", port, focus == 1);
    portRow.take();
    Task<int64> nickRow = spawn IrcUiSetupRow(canvas, x+16, y+175, 548,
        "Nickname", nick, focus == 2);
    nickRow.take();
    Task<int64> channelRow = spawn IrcUiSetupRow(canvas, x+16, y+222, 548,
        "Join channel", channel, focus == 3);
    channelRow.take();
    Task<int64> nameRow = spawn IrcUiSetupRow(canvas, x+16, y+269, 548,
        "Full name", realName, focus == 4);
    nameRow.take();
    int64 tlsBackground = 0xffffff;
    if(focus == 5) { tlsBackground = 0xe7f3ff; }
    Task<int64> tlsBox = spawn IrcUiPanel(canvas, x+16, y+318, 548, 34,
        tlsBackground);
    tlsBox.take();
    string tlsLabel = "[ ] Use TLS (verified server certificate)";
    if(tls) { tlsLabel = "[X] Use TLS (verified server certificate)"; }
    Task<int64> tlsText = spawn DrawCanvasTextRaw(canvas, tlsLabel,
        x+26, y+325, 0x203149);
    tlsText.take();
    Task<int64> trustRow = spawn IrcUiSetupRow(canvas, x+16, y+360, 548,
        "Trusted keys", trustPath, focus == 6);
    trustRow.take();
    Task<int64> feedback = spawn IrcUiClippedTextRaw(canvas, error,
        x+18, y+407, 540, 0xa22e35);
    feedback.take();
    Task<int64> saveButton = spawn IrcUiPanel(canvas, x+16, y+438, 160, 42, 0xe3ebf4);
    saveButton.take();
    Task<int64> saveText = spawn DrawCanvasTextRaw(canvas, "Save", x+70, y+449, 0x203149);
    saveText.take();
    Task<int64> connectButton = spawn IrcUiPanel(canvas, x+190, y+438, 180, 42, 0xd5e7fa);
    connectButton.take();
    Task<int64> connectText = spawn DrawCanvasTextRaw(canvas, "Connect", x+242, y+449, 0x203149);
    connectText.take();
    Task<int64> cancelButton = spawn IrcUiPanel(canvas, x+384, y+438, 180, 42, 0xe3ebf4);
    cancelButton.take();
    Task<int64> cancelText = spawn DrawCanvasTextRaw(canvas, "Cancel", x+436, y+449, 0x203149);
    cancelText.take();
    Task<int64> flushed = spawn DrawCanvasFlushRaw(canvas);
    return flushed.take();
}

function IrcUiPaint(int64 canvas, int64 width, int64 height, string connection,
                    string channel, string topic, string transcript, string statuslog,
                    string nicks, string input, string conversations, string selectedKey,
                    bool statusView, int64 scrollBack, int64 labelTick,
                    int64 selectionStart, int64 selectionEnd, bool flushNow) int64 {
    int64 chatWidth = width - 340;
    int64 chatHeight = height - 184;
    int64 tTrim = 0;
    int64 tFrame = 0;
    int64 tMessages = 0;
    string room;
    string trimmedTopic;
    c { o9_lat_begin(); }
    c {
        char *s;
        vlong n, b;

        s = o9_string_data(channel);
        n = s != nil ? o9_string_len(channel) : 0;
        b = 0;
        while(b < n && (s[b] == ' ' || s[b] == '\t' ||
                        s[b] == '\n' || s[b] == '\r'))
            b++;
        while(n > b && (s[n-1] == ' ' || s[n-1] == '\t' ||
                        s[n-1] == '\n' || s[n-1] == '\r'))
            n--;
        room = o9_string_new(s != nil ? s + b : "", n - b);

        s = o9_string_data(topic);
        n = s != nil ? o9_string_len(topic) : 0;
        b = 0;
        while(b < n && (s[b] == ' ' || s[b] == '\t' ||
                        s[b] == '\n' || s[b] == '\r'))
            b++;
        while(n > b && (s[n-1] == ' ' || s[n-1] == '\t' ||
                        s[n-1] == '\n' || s[n-1] == '\r'))
            n--;
        trimmedTopic = o9_string_new(s != nil ? s + b : "", n - b);
    }
    c { tTrim = o9_lat_end(); o9_lat_begin(); }
    string heading = cat("Topic: ", trimmedTopic);
    if(statusView) {
        c { o9_string_release(heading); }
        heading = "Network status and server replies";
    }
    if(scrollBack > 0) {
        string marked = cat(heading, "  [history]");
        c { o9_string_release(heading); }
        heading = marked;
    }
    Task<int64> frame = spawn IrcUiFrameRaw(canvas, width, height, connection, statusView,
                                            room, heading, labelTick, conversations,
                                            selectedKey, nicks, input);
    int64 frameFlags = frame.await();
    int64 roomScrolling = frameFlags & 1;
    int64 topicScrolling = (frameFlags >> 1) & 1;
    c { tFrame = o9_lat_end(); o9_lat_begin(); }

    string visible = transcript;
    if(statusView) { visible = statuslog; }
    Task<int64> messages = spawn IrcUiChatRaw(canvas, visible, chatWidth, chatHeight,
                                               scrollBack, selectionStart, selectionEnd,
                                               0, 0, 4, flushNow);
    int64 result = messages.await();
    c { tMessages = o9_lat_end(); }
    c {
        o9_task_close(frame);
        o9_task_close(messages);
        o9_string_release(room);
        o9_string_release(trimmedTopic);
        o9_string_release(heading);
        if(access("/n/9fat/o9irc-latency-on", AEXIST) >= 0){
            int fd;
            vlong elapsed;
            elapsed = tTrim + tFrame + tMessages;
            fd = open("/n/9fat/o9irc-latency", OWRITE);
            if(fd < 0)
                fd = create("/n/9fat/o9irc-latency", OWRITE, 0666);
            else
                seek(fd, 0, 2);
            if(fd >= 0){
                fprint(fd, "O9LAT paint ns=%lld trim=%lld frame=%lld messages=%lld\n",
                    elapsed, tTrim, tFrame, tMessages);
                close(fd);
            }
        }
    }
    if(result <= 0) { return 0; }
    if(roomScrolling != 0 || topicScrolling != 0) { return 1; }
    return 0;
}

class IrcSetup {
    prop string host;
    prop string port;
    prop string nick;
    prop string channel;
    prop string realName;
    prop bool tls;
    prop string trustPath;
    prop string feedback;
    prop bool opened;
    prop bool loaded;
    prop bool shown;
    prop bool mouseDown;
    prop int64 focus;

    method IrcSetup() {
        host = "";
        port = "6667";
        nick = "";
        channel = "";
        realName = "";
        tls = false;
        trustPath = "";
        feedback = "";
        opened = false;
        loaded = false;
        shown = false;
        mouseDown = false;
        focus = 0;
    }

    method bool visible() { return opened; }

    method void show() {
        opened = true;
        focus = 0;
        feedback = "";
    }

    method bool load(string path) {
        if(loaded) { return false; }
        string savedProfile = readfile(path);
        if(len(savedProfile) == 0) {
            savedProfile.dispose();
            return false;
        }
        Task<string> cleanProfile = spawn StringTrimRaw(savedProfile);
        string profileText = cleanProfile.take();
        savedProfile.dispose();
        Task<string> hostField = spawn StringFieldRaw(profileText, "\t", 0);
        Task<string> portField = spawn StringFieldRaw(profileText, "\t", 1);
        Task<string> nickField = spawn StringFieldRaw(profileText, "\t", 2);
        Task<string> channelField = spawn StringFieldRaw(profileText, "\t", 3);
        Task<string> nameField = spawn StringFieldRaw(profileText, "\t", 4);
        Task<string> transportField = spawn StringFieldRaw(profileText, "\t", 5);
        Task<string> trustField = spawn StringFieldRaw(profileText, "\t", 6);
        host = hostField.take();
        port = portField.take();
        nick = nickField.take();
        channel = channelField.take();
        realName = nameField.take();
        string savedTransport = transportField.take();
        tls = cmp(savedTransport, "tls") == 0;
        savedTransport.dispose();
        trustPath = trustField.take();
        loaded = true;
        profileText.dispose();
        return true;
    }

    method bool showIfDisconnected(string status) {
        if(loaded && !shown && cmp(status, "disconnected\n") == 0) {
            show();
            shown = true;
            return true;
        }
        return false;
    }

    method bool submit(string inputPath, bool connectNow) {
        if(len(host) == 0 || len(port) == 0 || len(nick) == 0) {
            feedback = "Enter a server, port, and nickname.";
            return false;
        }
        if(tls && len(trustPath) == 0) {
            feedback = "Choose a trusted-keys file before enabling TLS.";
            return false;
        }
        Task<string> profileCommand = spawn IrcUiProfileCommandRaw(
            connectNow, host, port, nick, channel, realName, tls, trustPath);
        string command = profileCommand.take();
        if(len(command) == 0) {
            feedback = "Settings are too long.";
            command.dispose();
            return false;
        }
        Task<int64> written = spawn IrcUiWriteInputRaw(inputPath, command);
        bool ok = written.take() >= 0;
        command.dispose();
        if(ok) {
            feedback = "";
            opened = false;
        } else {
            feedback = "Check the settings or start the IRC service.";
        }
        return ok;
    }

    method bool mouse(int64 eventCode, int64 width, int64 height, string inputPath) {
        int64 buttons = (eventCode >> 4) & 31;
        bool pressed = (buttons & 1) != 0;
        int64 x = (eventCode >> 9) & 2047;
        int64 y = (eventCode >> 20) & 2047;
        int64 left = (width-580)/2;
        int64 top = (height-492)/2;
        bool changed = false;
        if(pressed && !mouseDown) {
            if(x >= left+16 && x < left+564 && y >= top+81 &&
               y < top+81+5*47) {
                focus = (y-(top+81))/47;
                changed = true;
            }
            if(x >= left+16 && x < left+564 && y >= top+318 && y < top+352) {
                tls = !tls;
                if(tls && cmp(port, "6667") == 0) { port = "6697"; }
                focus = 5;
                changed = true;
            }
            if(x >= left+16 && x < left+564 && y >= top+360 && y < top+398) {
                focus = 6;
                changed = true;
            }
            if(y >= top+438 && y < top+480) {
                if(x >= left+384 && x < left+564) {
                    opened = false;
                    changed = true;
                } else if(x >= left+16 && x < left+370) {
                    submit(inputPath, x >= left+190);
                    changed = true;
                }
            }
        }
        mouseDown = pressed;
        return changed;
    }

    method bool key(int64 code) {
        if(code == 0x1b) {
            opened = false;
            return true;
        }
        if(code == 9 || code == 10 || code == 13) {
            focus = (focus+1)%7;
            return true;
        }
        if(focus == 5 && code == 32) {
            tls = !tls;
            if(tls && cmp(port, "6667") == 0) { port = "6697"; }
            return true;
        }
        if(code != 8 && code != 0x7f && (code < 32 || code > 126)) {
            return false;
        }
        if(focus == 0) {
            Task<string> edited = spawn IrcUiFieldEditRaw(host, code, 253);
            string previous = host;
            host = edited.take();
            previous.dispose();
        } else if(focus == 1) {
            Task<string> edited = spawn IrcUiFieldEditRaw(port, code, 5);
            string previous = port;
            port = edited.take();
            previous.dispose();
        } else if(focus == 2) {
            Task<string> edited = spawn IrcUiFieldEditRaw(nick, code, 30);
            string previous = nick;
            nick = edited.take();
            previous.dispose();
        } else if(focus == 3) {
            Task<string> edited = spawn IrcUiFieldEditRaw(channel, code, 64);
            string previous = channel;
            channel = edited.take();
            previous.dispose();
        } else if(focus == 4) {
            Task<string> edited = spawn IrcUiFieldEditRaw(realName, code, 80);
            string previous = realName;
            realName = edited.take();
            previous.dispose();
        } else if(focus == 6) {
            Task<string> edited = spawn IrcUiFieldEditRaw(trustPath, code, 255);
            string previous = trustPath;
            trustPath = edited.take();
            previous.dispose();
        }
        feedback = "";
        return true;
    }

    method void paint(int64 canvas, int64 width, int64 height) {
        Task<int64> drawn = spawn IrcUiPaintSetup(canvas, width, height,
            host, port, nick, channel, realName, tls, trustPath, focus, feedback);
        drawn.take();
    }
}

function IrcUiEventRaw(int64 canvas) int64 {
    use { draw event }
    int64 eventCode = 0;
    c {
                    Event ev;
                    int et;
                    ulong x, y, buttons, key;

                    if(canvas > 0 && display != nil){
                        if(o9_draw_resized){
                            o9_draw_resized = 0;
                            x = o9_draw_width & 0x7FF;
                            y = o9_draw_height & 0x7FF;
                            eventCode = (y << 20) | (x << 9) | 3;
                        }else{
                            et = event(&ev);
                            if(o9_draw_resized){
                                o9_draw_resized = 0;
                                x = o9_draw_width & 0x7FF;
                                y = o9_draw_height & 0x7FF;
                                eventCode = (y << 20) | (x << 9) | 3;
                            }else if(et == Emouse){
                                x = (ev.mouse.xy.x - screen->r.min.x) & 0x7FF;
                                y = (ev.mouse.xy.y - screen->r.min.y) & 0x7FF;
                                buttons = ev.mouse.buttons & 0x1F;
                                eventCode = (y << 20) | (x << 9) | (buttons << 4) | 1;
                            }else if(et == Ekeyboard){
                                key = ev.kbdc & 0xFFFF;
                                eventCode = (key << 9) | 2;
                            }
                        }
                    }
                }
    return eventCode;
}

function IrcUiRun() int64 {
    string mountPoint = "/mnt/o9irc";
    Task<int64> argCount = spawn ProcessArgcRaw();
    if(argCount.take() > 2) {
        Task<string> arg = spawn ProcessArgRaw(2);
        mountPoint = arg.take();
    }
    string base = cat(mountPoint, "/view/networks/default/");
    Task<int64> opened = spawn DrawCanvasOpenRaw("o9irc", 960, 660);
    int64 canvas = opened.take();
    if(canvas <= 0) {
        print("o9irc: cannot open Rio draw window\n");
    } else {
        Task<int64> timer = spawn IrcUiStartTimerRaw();
        timer.take();
        int64 width = 960;
        int64 height = 660;
        string connection = "waiting for 9P view";
        string channel = "";
        string topic = "";
        string transcript = "";
        string statuslog = "";
        string nicks = "";
        string input = "";
        string conversations = "";
        string selectedKey = "";
        string selectedName = "";
        string activePathKey = "";
        Dict<string,int64> scrolls;
        string statusPath = cat(base, "status");
        string channelPath = cat(base, "channel");
        string conversationsPath = cat(base, "conversations");
        string topicPath = cat(base, "topic");
        string transcriptPath = cat(base, "transcript");
        string statuslogPath = cat(base, "statuslog");
        string eventsPath = cat(base, "events");
        string nicksPath = cat(base, "nicks");
        string inputPath = cat(base, "input");
        string profilePath = cat(base, "profile");
        IrcSetup setup = new IrcSetup();
        bool statusView = false;
        int64 channelBack = 0;
        int64 statusBack = 0;
        bool mouseDown = false;
        bool selecting = false;
        bool selectionDirty = false;
        bool basePainted = false;
        int64 selectionStart = -1;
        int64 selectionEnd = -1;
        int64 pendingSelectionX = 0;
        int64 pendingSelectionY = 0;
        bool selectionPending = false;
        bool dirty = true;
        bool setupDirty = false;
        bool labelsDirty = false;
        bool inputDirty = false;
        bool labelsScrolling = false;
        int64 labelTick = 0;
        int64 timerTicks = 0;
        bool running = true;
        while(running) {
            if(running) {
                // Keep the packed event in 31 bits for the o9c 386 backend.
                Task<int64> polled = spawn IrcUiEventRaw(canvas);
                int64 eventCode = polled.take();
                int64 kind = eventCode & 15;
                bool setupWasOpen = setup.visible();
                if(kind == 0) {
                    timerTicks = timerTicks + 1;
                    if(selectionPending) {
                        string visible = transcript;
                        int64 back = channelBack;
                        if(statusView) {
                            visible = statuslog;
                            back = statusBack;
                        }
                        Task<int64> hit = spawn IrcUiHitChatRaw(visible, width - 340,
                            height - 184, back, pendingSelectionX, pendingSelectionY);
                        int64 position = hit.take();
                        if(selectionEnd != position) {
                            selectionEnd = position;
                            selectionDirty = true;
                        }
                        selectionPending = false;
                    }
                    if(selectionDirty) {
                        // Coalesce selection drags: one hit test and one
                        // repaint per timer tick instead of per mouse event.
                        dirty = true;
                        selectionDirty = false;
                    }
                    if(labelsScrolling && timerTicks % 3 == 0) {
                        labelTick = labelTick + 1;
                        labelsDirty = true;
                    }
                }
                if(kind == 1 && setupWasOpen) {
                    if(setup.mouse(eventCode, width, height, inputPath)) {
                        if(setup.visible()) { setupDirty = true; }
                        else { dirty = true; }
                    }
                }
                if(kind == 1 && !setupWasOpen) {
                    int64 buttons = (eventCode >> 4) & 31;
                    bool pressed = (buttons & 1) != 0;
                    bool middlePressed = (buttons & 2) != 0;
                    bool rightPressed = (buttons & 4) != 0;
                    int64 x = (eventCode >> 9) & 2047;
                    int64 y = (eventCode >> 20) & 2047;
                    bool inChat = y >= 112 && y < height - 72 && x >= 180 && x < width - 160;
                    if(inChat && (buttons & 24) != 0) {
                        string visible = transcript;
                        int64 back = channelBack;
                        if(statusView) {
                            visible = statuslog;
                            back = statusBack;
                        }
                        if((buttons & 8) != 0) { back = back + 3; }
                        if((buttons & 16) != 0) { back = back - 3; }
                        Task<int64> maximum = spawn IrcUiMaxBack(visible, width, height);
                        int64 maxBack = maximum.take();
                        if(back < 0) { back = 0; }
                        if(back > maxBack) { back = maxBack; }
                        if(statusView) { statusBack = back; } else { channelBack = back; }
                        dirty = true;
                    }
                    if(pressed && !mouseDown && inChat) {
                        string visible = transcript;
                        int64 back = channelBack;
                        if(statusView) { visible = statuslog; back = statusBack; }
                        Task<int64> hit = spawn IrcUiHitChatRaw(visible, width - 340,
                            height - 184, back, x, y);
                        selectionStart = hit.take();
                        selectionEnd = selectionStart;
                        selecting = true;
                        dirty = true;
                    } else if(selecting) {
                        pendingSelectionX = x;
                        pendingSelectionY = y;
                        selectionPending = true;
                        selectionDirty = true;
                        if(!pressed) {
                            string visible = transcript;
                            int64 back = channelBack;
                            if(statusView) { visible = statuslog; back = statusBack; }
                            Task<int64> hit = spawn IrcUiHitChatRaw(visible, width - 340,
                                height - 184, back, x, y);
                            selectionEnd = hit.take();
                            selecting = false;
                            selectionPending = false;
                            dirty = true;
                            selectionDirty = false;
                        }
                    }
                    bool copySelected = middlePressed && inChat;
                    bool menuClick = pressed && !mouseDown && y >= 6 && y < 34 && x >= 94 && x < 260;
                    bool contextClick = rightPressed;
                    bool usedMenu = false;
                    if(menuClick || contextClick) {
                        int64 button = 1;
                        if(contextClick) { button = 3; }
                        Task<int64> picked = spawn DrawMenuHitRaw(canvas, button, x, y, buttons, 8,
                            "connection setup", "status view", "join channel", "change nick",
                            "message nick", "quit IRC", "close window", "copy selection");
                        int64 choice = picked.take();
                        if(choice == 0) {
                            setup.show();
                            setupDirty = true;
                        } else if(choice == 1) {
                            statusView = true;
                            selectionStart = -1;
                            selectionEnd = -1;
                            selecting = false;
                            dirty = true;
                        } else if(choice == 2) {
                            input.dispose();
                            input = "/join #";
                            inputDirty = true;
                        } else if(choice == 3) {
                            input.dispose();
                            input = "/nick ";
                            inputDirty = true;
                        } else if(choice == 4) {
                            input.dispose();
                            input = "/msg ";
                            inputDirty = true;
                        } else if(choice == 5) {
                            Task<int64> written = spawn IrcUiWriteInputRaw(inputPath, "quit\n");
                            if(written.take() < 0) {
                                connection.dispose();
                                connection = "quit rejected by 9P view";
                            }
                            dirty = true;
                        } else if(choice == 6) {
                            running = false;
                        } else if(choice == 7) {
                            copySelected = true;
                        }
                        usedMenu = true;
                        dirty = true;
                    } else if(pressed && !mouseDown) {
                        if((y >= 40 && y < 68 && x >= 6 && x < 96) ||
                           (y >= 102 && y < 128 && x >= 18 && x < 170)) {
                            statusView = true;
                            selectionStart = -1;
                            selectionEnd = -1;
                            selecting = false;
                            dirty = true;
                        } else if(y >= 156 && y < height - 68 && x >= 18 && x < 170) {
                            int64 row = (y - 156) / 22;
                            Task<string> newKey = spawn IrcUiIndexFieldRaw(conversations, row, false);
                            string chosen = newKey.take();
                            if(len(chosen) > 0 && cmp(chosen, selectedKey) != 0) {
                                if(len(selectedKey) > 0) { scrolls[selectedKey] = channelBack; }
                                selectedKey.dispose(); selectedName.dispose();
                                selectedKey = chosen;
                                Task<string> newName = spawn IrcUiIndexFieldRaw(conversations, row, true);
                                selectedName = newName.take();
                                channelBack = 0;
                                if(scrolls.Has(selectedKey)) { channelBack = scrolls[selectedKey]; }
                            } else {
                                chosen.dispose();
                            }
                            statusView = false;
                            selectionStart = -1;
                            selectionEnd = -1;
                            selecting = false;
                            dirty = true;
                        } else if(y >= 40 && y < 68 && x >= 96 && x < width - 12) {
                            statusView = false;
                            selectionStart = -1;
                            selectionEnd = -1;
                            selecting = false;
                            dirty = true;
                        } else if(y >= 112 && y < height - 72 && x >= width - 154 && x < width - 12) {
                            int64 index = (y - 118) / 18;
                            Task<string> field = spawn StringFieldRaw(nicks, "\n", index);
                            string rawWho = field.take();
                            Task<string> trimmed = spawn StringTrimRaw(rawWho);
                            string who = trimmed.take();
                            rawWho.dispose();
                            if(len(who) > 0) {
                                Task<int64> op = spawn StringStartsWithRaw(who, "@");
                                Task<int64> voice = spawn StringStartsWithRaw(who, "+");
                                int64 prefixOp = op.take();
                                int64 prefixVoice = voice.take();
                                if(prefixOp != 0 || prefixVoice != 0) {
                                    Task<string> bare = spawn StringSliceRaw(who, 1, len(who) - 1);
                                    string bareText = bare.take();
                                    who.dispose();
                                    who = bareText;
                                }
                                input.dispose();
                                input = cat(cat("/msg ", who), " ");
                                who.dispose();
                                inputDirty = true;
                            } else {
                                who.dispose();
                            }
                        }
                    }
                    if(copySelected && selectionStart >= 0 && selectionStart != selectionEnd) {
                        string visible = transcript;
                        if(statusView) { visible = statuslog; }
                        Task<int64> copied = spawn IrcUiCopySelectionRaw(visible,
                            selectionStart, selectionEnd);
                        copied.take();
                    }
                    if(usedMenu) {
                        mouseDown = false;
                    } else {
                        mouseDown = pressed;
                    }
                }
                if(kind == 2 && setupWasOpen) {
                    if(setup.key((eventCode >> 9) & 65535)) {
                        if(setup.visible()) { setupDirty = true; }
                        else { dirty = true; }
                    }
                }
                if(kind == 2 && !setupWasOpen) {
                    int64 key = (eventCode >> 9) & 65535;
                    if(key == 0x1b) {
                        running = false;
                    } else if(key == 0xF00F || key == 0xF013 ||
                              key == 0xF00D || key == 0xF018) {
                        string visible = transcript;
                        int64 back = channelBack;
                        if(statusView) {
                            visible = statuslog;
                            back = statusBack;
                        }
                        Task<int64> maximum = spawn IrcUiMaxBack(visible, width, height);
                        int64 maxBack = maximum.take();
                        int64 page = (height - 196) / 18;
                        if(page < 1) { page = 1; }
                        if(key == 0xF00F) { back = back + page; }
                        if(key == 0xF013) { back = back - page; }
                        if(key == 0xF00D) { back = maxBack; }
                        if(key == 0xF018) { back = 0; }
                        if(back < 0) { back = 0; }
                        if(back > maxBack) { back = maxBack; }
                        if(statusView) { statusBack = back; } else { channelBack = back; }
                        dirty = true;
                    } else if(key == 8 || key == 0x7f) {
                        if(len(input) > 0) {
                            Task<string> shortened = spawn StringSliceRaw(input, 0, len(input) - 1);
                            string shorterInput = shortened.take();
                            input.dispose();
                            input = shorterInput;
                            inputDirty = true;
                        }
                    } else if(key == 10 || key == 13) {
                        if(len(input) > 0) {
                            string command = cat("say ", input);
                            if(len(selectedName) > 0) {
                                command.dispose();
                                command = cat(cat(cat("msg ", selectedName), " "), input);
                            }
                            Task<int64> slash = spawn StringStartsWithRaw(input, "/");
                            if(slash.take() != 0) {
                                Task<string> withoutSlash = spawn StringSliceRaw(input, 1, len(input) - 1);
                                command.dispose();
                                command = withoutSlash.take();
                            }
                            string framed = cat(command, "\n");
                            Task<int64> written = spawn IrcUiWriteInputRaw(inputPath, framed);
                            int64 writeResult = written.take();
                            framed.dispose();
                            command.dispose();
                            if(writeResult < 0) {
                                connection.dispose();
                                connection = "command rejected by 9P view";
                                dirty = true;
                            } else {
                                input.dispose();
                                input = "";
                            }
                            inputDirty = true;
                        }
                    } else if(key >= 32 && key <= 126) {
                        Task<string> inserted = spawn DrawTextInsertRaw(input, len(input), key);
                        string insertedText = inserted.take();
                        input.dispose();
                        input = insertedText;
                        inputDirty = true;
                    }
                }
                if(kind == 3) {
                    width = (eventCode >> 9) & 2047;
                    height = (eventCode >> 20) & 2047;
                    if(width < 640) { width = 640; }
                    if(height < 440) { height = 440; }
                    basePainted = false;
                    dirty = true;
                }
            }
            if(setup.load(profilePath)) {
                if(setup.visible()) { setupDirty = true; }
                else { dirty = true; }
            }
            string nextConversations = readfile(conversationsPath);
            if(cmp(nextConversations, conversations) != 0) {
                conversations.dispose();
                conversations = nextConversations;
                if(len(selectedKey) == 0 && len(conversations) > 0) {
                    Task<string> firstKey = spawn IrcUiIndexFieldRaw(conversations, 0, false);
                    Task<string> firstName = spawn IrcUiIndexFieldRaw(conversations, 0, true);
                    selectedKey = firstKey.take();
                    selectedName = firstName.take();
                }
                dirty = true;
            } else {
                nextConversations.dispose();
            }
            if(cmp(activePathKey, selectedKey) != 0) {
                activePathKey.dispose(); topicPath.dispose(); transcriptPath.dispose(); nicksPath.dispose();
                activePathKey = cat(selectedKey, "");
                string selectedRoot = cat(base, selectedKey);
                topicPath = cat(selectedRoot, "/topic");
                transcriptPath = cat(selectedRoot, "/transcript");
                nicksPath = cat(selectedRoot, "/nicks");
                selectedRoot.dispose();
            }
            string nextConnection = readfile(statusPath);
            if(setup.showIfDisconnected(nextConnection)) { setupDirty = true; }
            string nextChannel = readfile(channelPath);
            if(len(selectedName) > 0) {
                nextChannel.dispose();
                nextChannel = cat(selectedName, "\n");
            }
            string nextTopic = readfile(topicPath);
            string nextTranscript = readfile(transcriptPath);
            string nextStatuslog = readfile(statuslogPath);
            if(len(nextStatuslog) == 0) {
                nextStatuslog.dispose();
                nextStatuslog = readfile(eventsPath);
            }
            string nextNicks = readfile(nicksPath);
            if(len(nextConnection) == 0) {
                nextConnection.dispose();
                nextConnection = "9P view unavailable: mount /srv/ircfs first";
            }
            if(cmp(nextConnection, connection) != 0 || cmp(nextChannel, channel) != 0 ||
               cmp(nextTopic, topic) != 0 || cmp(nextTranscript, transcript) != 0 ||
               cmp(nextStatuslog, statuslog) != 0 ||
               cmp(nextNicks, nicks) != 0) {
                if((statusView && cmp(nextStatuslog, statuslog) != 0) ||
                   (!statusView && cmp(nextTranscript, transcript) != 0)) {
                    selectionStart = -1;
                    selectionEnd = -1;
                    selecting = false;
                    selectionPending = false;
                    selectionDirty = false;
                }
                if(channelBack > 0 && cmp(nextTranscript, transcript) != 0) {
                    Task<int64> oldLines = spawn IrcUiChatRaw(0, transcript,
                        width - 340, height - 184, 0, -1, -1, 0, 0, 0, false);
                    Task<int64> newLines = spawn IrcUiChatRaw(0, nextTranscript,
                        width - 340, height - 184, 0, -1, -1, 0, 0, 0, false);
                    int64 added = newLines.take() - oldLines.take();
                    if(added > 0) { channelBack = channelBack + added; }
                    if(channelBack < 0) { channelBack = 0; }
                }
                if(statusBack > 0 && cmp(nextStatuslog, statuslog) != 0) {
                    Task<int64> oldLines = spawn IrcUiChatRaw(0, statuslog,
                        width - 340, height - 184, 0, -1, -1, 0, 0, 0, false);
                    Task<int64> newLines = spawn IrcUiChatRaw(0, nextStatuslog,
                        width - 340, height - 184, 0, -1, -1, 0, 0, 0, false);
                    int64 added = newLines.take() - oldLines.take();
                    if(added > 0) { statusBack = statusBack + added; }
                    if(statusBack < 0) { statusBack = 0; }
                }
                connection.dispose(); channel.dispose(); topic.dispose(); transcript.dispose(); statuslog.dispose(); nicks.dispose();
                connection = nextConnection;
                channel = nextChannel;
                topic = nextTopic;
                transcript = nextTranscript;
                statuslog = nextStatuslog;
                nicks = nextNicks;
                dirty = true;
            } else {
                nextConnection.dispose(); nextChannel.dispose(); nextTopic.dispose(); nextTranscript.dispose(); nextStatuslog.dispose(); nextNicks.dispose();
            }
            if(dirty && (!setup.visible() || !basePainted)) {
                int64 scrollBack = channelBack;
                if(statusView) { scrollBack = statusBack; }
                Task<int64> painted = spawn IrcUiPaint(canvas, width, height, connection, channel,
                                                         topic, transcript, statuslog, nicks, input,
                                                         conversations, selectedKey,
                                                         statusView, scrollBack, labelTick,
                                                         selectionStart, selectionEnd,
                                                         !setup.visible());
                labelsScrolling = painted.take() != 0;
                if(setup.visible()) { setup.paint(canvas, width, height); }
                basePainted = true;
                dirty = false;
                setupDirty = false;
                labelsDirty = false;
                inputDirty = false;
            } else if(setup.visible() && setupDirty) {
                setup.paint(canvas, width, height);
                setupDirty = false;
            } else if(inputDirty && !setup.visible()) {
                Task<int64> paintedInput = spawn IrcUiPaintInput(canvas, width, height, input, true);
                paintedInput.take();
                inputDirty = false;
            } else if(labelsDirty && !setup.visible()) {
                int64 scrollBack = channelBack;
                if(statusView) { scrollBack = statusBack; }
                Task<int64> paintedLabels = spawn IrcUiPaintLabels(canvas, width,
                    channel, topic, statusView, scrollBack, labelTick);
                labelsScrolling = paintedLabels.take() != 0;
                labelsDirty = false;
            }
            if(setup.visible()) {
                inputDirty = false;
                labelsDirty = false;
            }
        }
        Task<int64> closed = spawn DrawCanvasCloseRaw(canvas);
        closed.take(); statusPath.dispose(); channelPath.dispose(); conversationsPath.dispose(); topicPath.dispose(); transcriptPath.dispose(); statuslogPath.dispose(); eventsPath.dispose(); nicksPath.dispose(); inputPath.dispose(); profilePath.dispose(); connection.dispose(); channel.dispose(); topic.dispose(); transcript.dispose(); statuslog.dispose(); nicks.dispose(); input.dispose(); conversations.dispose(); selectedKey.dispose(); selectedName.dispose(); activePathKey.dispose(); base.dispose(); mountPoint.dispose();
    }
    return 0;
}

main {
    Task<int64> run = spawn IrcUiRun();
    run.take();
}

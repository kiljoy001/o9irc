// Write to an existing 9P command file at offset zero.
function IrcUiWriteInputRaw(string path, string data) int64 {
    int64 out;
    c {
        char *name;
        int fd;
        vlong n;

        out = -1;
        name = o9_string_cstr(path);
        if(name != nil){
            fd = open(name, OWRITE);
            free(name);
            if(fd >= 0){
                n = o9_string_len(data);
                if(n > 0){
                    vlong done = 0;
                    while(done < n){
                        vlong wrote = write(fd, o9_string_data(data) + done, n - done);
                        if(wrote <= 0)
                            break;
                        done += wrote;
                    }
                    if(done == n)
                        out = n;
                }
                close(fd);
            }
        }
    }
    return out;
}

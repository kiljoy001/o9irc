// A small terminal IRC client written in o9c.
import "protocol.o9";
import "process.o9";

function IrcLine(string fd, string line, string initialChannel) int64 {
    Task<string> parsed = spawn IrcPayload(line);
    string rest = parsed.take();
    if(len(rest) == 0) {
        rest.dispose();
        return 0;
    }
    Task<int64> commandEnd = spawn StringIndexOfRaw(rest, " ");
    int64 pos = commandEnd.take();
    string command = rest;
    string params = "";
    bool split = false;
    if(pos >= 0 && pos < len(rest)) {
        Task<string> name = spawn StringSliceRaw(rest, 0, pos);
        Task<string> tail = spawn StringSliceRaw(rest, pos + 1, len(rest) - pos - 1);
        command = name.take();
        params = tail.take();
        split = true;
    }
    int64 result = 0;
    if(cmp(command, "PING") == 0) {
        if(len(params) > 0) {
            string response = cat("PONG ", params);
            Task<bool> pong = spawn IrcSend(fd, response);
            pong.take();
            response.dispose();
        }
    } else if(cmp(command, "001") == 0 && len(initialChannel) > 0) {
        string request = cat("JOIN ", initialChannel);
        Task<bool> join = spawn IrcSend(fd, request);
        join.take();
        request.dispose();
        print(line, "\n");
    } else if(cmp(command, "ERROR") == 0) {
        print("irc: ", line, "\n");
        result = -1;
    } else {
        print(line, "\n");
    }
    if(split) {
        command.dispose();
        params.dispose();
    }
    rest.dispose();
    return result;
}

function IrcReceive(string fd, string initialChannel, string initialNick) int64 {
    string pending = "";
    int64 nickFallbacks = 0;
    bool registered = false;
    byte crbyte = 13;
    Task<string> crtext = spawn BytesAppendRaw("", crbyte);
    string crchar = crtext.take();
    while(true) {
        Task<string> incoming = spawn NetReadRaw(fd, 2048);
        string chunk = incoming.take();
        if(len(chunk) == 0) {
            print("irc: connection closed\n");
            pending.dispose();
            crchar.dispose();
            return 0;
        }
        string joined = cat(pending, chunk);
        chunk.dispose();
        pending.dispose();
        pending = joined;
        Task<int64> newline = spawn StringIndexOfRaw(pending, "\n");
        int64 pos = newline.take();
        while(pos >= 0 && pos < len(pending)) {
            Task<string> head = spawn StringSliceRaw(pending, 0, pos);
            Task<string> tail = spawn StringSliceRaw(pending, pos + 1, len(pending) - pos - 1);
            string line = head.take();
            string restPending = tail.take();
            pending.dispose();
            pending = restPending;
            Task<int64> cr = spawn StringEndsWithRaw(line, crchar);
            if(cr.take() != 0) {
                Task<string> trimmed = spawn StringSliceRaw(line, 0, len(line) - 1);
                string trimmedLine = trimmed.take();
                line.dispose();
                line = trimmedLine;
            }
            if(len(line) > 0) {
                Task<string> parsed = spawn IrcPayload(line);
                string payload = parsed.take();
                Task<string> commandField = spawn StringFieldRaw(payload, " ", 0);
                string command = commandField.take();
                if(cmp(command, "001") == 0) { registered = true; }
                if(cmp(command, "433") == 0 && !registered) {
                    if(nickFallbacks < 9) {
                        nickFallbacks = nickFallbacks + 1;
                        Task<string> candidate = spawn IrcNickFallbackRaw(initialNick, nickFallbacks);
                        string nextNick = candidate.take();
                        string request = cat("NICK ", nextNick);
                        Task<bool> sent = spawn IrcSend(fd, request);
                        if(sent.take()) {
                            print("irc: nickname in use; trying ", nextNick, "\n");
                        }
                        request.dispose();
                        nextNick.dispose();
                    } else {
                        print("irc: fallback nicknames exhausted; use /nick name\n");
                    }
                }
                command.dispose();
                payload.dispose();
                Task<int64> handled = spawn IrcLine(fd, line, initialChannel);
                int64 handledResult = handled.take();
                line.dispose();
                if(handledResult < 0) {
                    pending.dispose();
                    crchar.dispose();
                    return -1;
                }
            } else {
                line.dispose();
            }
            Task<int64> next = spawn StringIndexOfRaw(pending, "\n");
            pos = next.take();
        }
        if(len(pending) > 8192) {
            print("irc: server line too long\n");
            pending.dispose();
            crchar.dispose();
            return -1;
        }
    }
}

main {
    Task<int64> count = spawn ProcessArgcRaw();
    if(count.take() < 4) {
        print("usage: irc irc tcp!server!6667 nick [#channel]\n");
    } else {
        Task<string> addressArg = spawn ProcessArgRaw(2);
        Task<string> nickArg = spawn ProcessArgRaw(3);
        string address = addressArg.take();
        string nick = nickArg.take();
        string channel = "";
        Task<int64> countAgain = spawn ProcessArgcRaw();
        if(countAgain.take() > 4) {
            Task<string> channelArg = spawn ProcessArgRaw(4);
            channel = channelArg.take();
        }
        Task<string> dial = spawn NetDialRaw(address);
        string fd = dial.take();
        if(len(fd) == 0) {
            print("irc: cannot dial ", address, "\n");
        } else {
            string nickRequest = cat("NICK ", nick);
            Task<bool> registrationNick = spawn IrcSend(fd, nickRequest);
            registrationNick.take();
            nickRequest.dispose();
            string userMiddle = cat(cat("USER ", nick), " 0 * :");
            string userRequest = cat(userMiddle, nick);
            Task<bool> registrationUser = spawn IrcSend(fd, userRequest);
            registrationUser.take();
            userRequest.dispose();
            userMiddle.dispose();
            Task<int64> reader = spawn IrcReceive(fd, channel, nick);
            print("irc: connected; /join, /msg, /nick, /quit; plain text sends to ", channel, "\n");
            bool done = false;
            while(!done) {
                string input = readline();
                if(len(input) == 0) {
                    input.dispose();
                    done = true;
                } else {
                    Task<int64> quit = spawn StringStartsWithRaw(input, "/quit");
                    Task<int64> join = spawn StringStartsWithRaw(input, "/join ");
                    Task<int64> msg = spawn StringStartsWithRaw(input, "/msg ");
                    Task<int64> newNick = spawn StringStartsWithRaw(input, "/nick ");
                    int64 wantQuit = quit.take();
                    int64 wantJoin = join.take();
                    int64 wantMessage = msg.take();
                    int64 wantNick = newNick.take();
                    if(wantQuit != 0) {
                        Task<bool> goodbye = spawn IrcSend(fd, "QUIT :leaving");
                        goodbye.take();
                        done = true;
                    } else if(wantJoin != 0) {
                        Task<string> target = spawn StringSliceRaw(input, 6, len(input) - 6);
                        string nextChannel = target.take();
                        channel.dispose();
                        channel = nextChannel;
                        string request = cat("JOIN ", channel);
                        Task<bool> joined = spawn IrcSend(fd, request);
                        joined.take();
                        request.dispose();
                    } else if(wantMessage != 0) {
                        Task<string> args = spawn StringSliceRaw(input, 5, len(input) - 5);
                        string argline = args.take();
                        Task<int64> gap = spawn StringIndexOfRaw(argline, " ");
                        int64 pos = gap.take();
                        if(pos > 0 && pos < len(argline) - 1) {
                            Task<string> target = spawn StringSliceRaw(argline, 0, pos);
                            Task<string> body = spawn StringSliceRaw(argline, pos + 1, len(argline) - pos - 1);
                            string destination = target.take();
                            string words = body.take();
                            string request = cat(cat(cat("PRIVMSG ", destination), " :"), words);
                            Task<bool> privateMessage = spawn IrcSend(fd, request);
                            privateMessage.take();
                            request.dispose();
                            destination.dispose();
                            words.dispose();
                        } else {
                            print("usage: /msg target text\n");
                        }
                        argline.dispose();
                    } else if(wantNick != 0) {
                        Task<string> replacement = spawn StringSliceRaw(input, 6, len(input) - 6);
                        string nextNick = replacement.take();
                        nick.dispose();
                        nick = nextNick;
                        string request = cat("NICK ", nick);
                        Task<bool> changedNick = spawn IrcSend(fd, request);
                        changedNick.take();
                        request.dispose();
                    } else if(cmp(input, "/help") == 0) {
                        print("/join #channel; /msg target text; /nick name; /quit\n");
                    } else if(len(channel) == 0) {
                        print("irc: join a channel or use /msg target text\n");
                    } else {
                        string request = cat(cat(cat("PRIVMSG ", channel), " :"), input);
                        Task<bool> channelMessage = spawn IrcSend(fd, request);
                        channelMessage.take();
                        request.dispose();
                    }
                    input.dispose();
                }
            }
            Task<int64> close = spawn NetCloseRaw(fd);
            close.take();
        }
    }
}

// IRC network actor with a composable 9P view. A GUI mounts this service.
import "protocol.o9";
import "state.o9";
import "history.o9";
import "file.o9";
import "process.o9";
import "time.o9";

interface ViewController {
    internal method FileTree display(string id, string caller);
    internal method string readText(string id, string path);
    internal method int64 writeText(string id, string path, int64 offset, string text, bool truncate);
}

// IRC targets become case-folded, path-safe 9P names. The displayed name
// remains the spelling supplied by the server or user.
function IrcViewKeyRaw(string target) string {
    string out;
    c {
        static char hex[] = "0123456789abcdef";
        char key[129];
        uchar *p;
        int i, n, ch;

        p = (uchar*)o9_string_data(target);
        n = o9_string_len(target);
        if(n > 64)
            n = 64;
        for(i = 0; i < n; i++){
            ch = p[i];
            if(ch >= 'A' && ch <= 'Z')
                ch += 'a' - 'A';
            else if(ch == '{')
                ch = '[';
            else if(ch == '}')
                ch = ']';
            else if(ch == '|')
                ch = '\\';
            else if(ch == '^')
                ch = '~';
            key[2*i] = hex[(ch >> 4) & 15];
            key[2*i+1] = hex[ch & 15];
        }
        key[2*n] = 0;
        out = o9_string_from_c(key);
    }
    return out;
}

function IrcValidTargetRaw(string target) bool {
    bool out;
    c {
        uchar *p;
        int i, n;

        p = (uchar*)o9_string_data(target);
        n = o9_string_len(target);
        out = n > 0 && n <= 64;
        for(i = 0; i < n; i++)
            if(p[i] <= ' ' || p[i] == ',' || p[i] == '/' || p[i] == 127)
                out = 0;
    }
    return out;
}

function IrcIsChannelRaw(string target) bool {
    bool out;
    c {
        char *p;
        p = o9_string_data(target);
        out = o9_string_len(target) > 1 &&
            (p[0] == '#' || p[0] == '&' || p[0] == '+' || p[0] == '!');
    }
    return out;
}

function IrcSenderRaw(string line) string {
    string out;
    c {
        char *p, *start;
        int n;

        p = o9_string_data(line);
        if(*p == '@'){
            p = strchr(p, ' ');
            if(p != nil)
                p++;
        }
        start = p;
        if(start != nil && *start == ':'){
            start++;
            p = start;
            while(*p != 0 && *p != '!' && *p != ' ')
                p++;
            n = p - start;
            out = o9_string_new(start, n);
        }else
            out = o9_string_from_c("");
    }
    return out;
}

function IrcTrailingRaw(string payload) string {
    string out;
    c {
        char *p;
        p = strstr(o9_string_data(payload), " :");
        out = p != nil ? o9_string_from_c(p+2) : o9_string_from_c("");
    }
    return out;
}

// The network pump has one reader. Keep incomplete frames in one bounded
// buffer so receiving a line does not create an actor for every slice.
function IrcReadLineRaw(string token, int64 generation) string {
    string out;
    c {
        static char pending[8192];
        static int used, previous = -1;
        static vlong previousGen = -1;
        char *end, *name;
        int fd, n, size;

        out = o9_string_from_c("");
        name = o9_string_cstr(token);
        if(name != nil){
            fd = atoi(name);
            free(name);
            if(generation != previousGen){
                used = 0;
                previous = -1;
                previousGen = generation;
            }
            if(fd != previous){
                used = 0;
                previous = fd;
            }
            for(;;){
                end = memchr(pending, '\n', used);
                if(end != nil){
                    size = end - pending;
                    n = size + 1;
                    if(size > 0 && pending[size-1] == '\r')
                        size--;
                    if(size > 0){
                        o9_string_release(out);
                        out = o9_string_new(pending, size);
                    }
                    used -= n;
                    memmove(pending, pending + n, used);
                    if(size > 0)
                        break;
                    continue;
                }
                if(used == sizeof pending){
                    used = 0;
                    previous = -1;
                    break;
                }
                n = read(fd, pending + used, sizeof pending - used);
                if(n <= 0){
                    used = 0;
                    previous = -1;
                    break;
                }
                used += n;
            }
        }
    }
    return out;
}

function IrcFormatChatRaw(string stamp, string sender, string body) string {
    string out;
    c {
        char *buf;
        vlong n;

        n = o9_string_len(stamp) + o9_string_len(sender) +
            o9_string_len(body) + 8;
        out = o9_string_from_c("");
        if(n > 0 && n <= 16384 && (buf = malloc(n + 1)) != nil){
            n = snprint(buf, n + 1, "[%.*s] <%.*s> %.*s\n",
                (int)o9_string_len(stamp), o9_string_data(stamp),
                (int)o9_string_len(sender), o9_string_data(sender),
                (int)o9_string_len(body), o9_string_data(body));
            o9_string_release(out);
            out = o9_string_new(buf, n);
            free(buf);
        }
    }
    return out;
}

// One local connection profile. The last two fields are transport and
// trusted-keys path. Five-field profiles from older versions remain valid.
function IrcProfileValidRaw(string value) bool {
    bool out;
    c {
        uchar *p;
        vlong n, i;
        int field, width, port, tls;

        p = (uchar*)o9_string_data(value);
        n = o9_string_len(value);
        out = n > 0 && n <= 768;
        field = 0;
        width = 0;
        port = 0;
        tls = 0;
        for(i = 0; out && i < n; i++){
            if(p[i] == '\t'){
                if(field == 0 && (width == 0 || width > 253)) out = 0;
                if(field == 1 && (width == 0 || width > 5 || port < 1 || port > 65535)) out = 0;
                if(field == 2 && (width == 0 || width > 30)) out = 0;
                if(field == 3 && width > 64) out = 0;
                if(field == 4 && width > 80) out = 0;
                if(field == 5 && width != 3) out = 0;
                field++;
                width = 0;
                continue;
            }
            if(p[i] < 32 || p[i] == 127 || field > 6) { out = 0; break; }
            if(field == 0 && (p[i] == '!' || p[i] == '/' || p[i] == ' ')) out = 0;
            if(field == 1){
                if(p[i] < '0' || p[i] > '9') out = 0;
                else if(width >= 5) out = 0;
                else port = port*10 + p[i]-'0';
            }
            if((field == 2 || field == 3) && (p[i] <= ' ' || p[i] == ',' || p[i] == '/')) out = 0;
            if(field == 3 && width == 0 && p[i] != '#' && p[i] != '&' &&
               p[i] != '+' && p[i] != '!') out = 0;
            if(field == 5){
                if(width == 0 && p[i] != 't') out = 0;
                if(width == 1){
                    if(p[i] == 'l') tls = 1;
                    else if(p[i] != 'c') out = 0;
                }
                if(width == 2 && p[i] != (tls ? 's' : 'p')) out = 0;
            }
            if(field == 6 && (width == 0 && p[i] != '/' || p[i] == '\\')) out = 0;
            width++;
        }
        if(field == 4 && width > 80) out = 0;
        else if(field == 6 && (width > 255 || (tls && width == 0))) out = 0;
        else if(field != 4 && field != 6) out = 0;
    }
    return out;
}

function IrcProfileLoadRaw(string path) string {
    string out;
    c {
        char *name;
        char buf[769];
        int fd, n;

        out = o9_string_from_c("");
        name = o9_string_cstr(path);
        if(name != nil && (fd = open(name, OREAD)) >= 0){
            n = read(fd, buf, sizeof buf);
            // Editors commonly leave a trailing newline; the profile grammar
            // has no terminator and rejects control characters.
            while(n > 0 && (buf[n-1] == '\n' || buf[n-1] == '\r'))
                n--;
            if(n > 0 && n <= 768){
                o9_string_release(out);
                out = o9_string_new(buf, n);
            }
            close(fd);
        }
        free(name);
    }
    return out;
}

function IrcProfileSaveRaw(string path, string value) bool {
    bool out;
    c {
        char *name;
        int fd;
        vlong n;

        out = 0;
        name = o9_string_cstr(path);
        if(name != nil && (fd = create(name, OWRITE, 0600)) >= 0){
            n = o9_string_len(value);
            out = write(fd, o9_string_data(value), n) == n;
            close(fd);
        }
        free(name);
    }
    return out;
}

// tlsClient consumes the TCP descriptor on success. Its returned descriptor
// carries plaintext IRC bytes through the kernel TLS device. A connection is
// usable only when its presented certificate matches the trusted-keys file.
function IrcDialTLSRaw(string address, string host, string trustPath) string {
    return "error:TLS unavailable in Aspera guest";
}

class IrcNetwork {
    private FileTree files;
    private string identifier;
    private string displayName;
    private string fd;
    private string channel;
    private string activeKey;
    private string activeTarget;
    private string nick;
    private string registrationBase;
    private int64 nickFallbacks;
    private bool registered;
    private bool wantConnected;
    private bool linkUp;
    private bool shuttingDown;
    private bool supervisorStarted;
    private int64 generation;
    private int64 attempt;
    private int64 maxAttempts;
    private int64 backoffSec;
    private int64 nextAttemptSec;
    private int64 lastIncomingSec;
    private int64 lastPingSec;
    private string lastError;
    private string statusText;
    private string events;
    private string statuslog;
    private string address;
    private string realName;
    private string transport;
    private string trustPath;
    private string serverHost;
    private string profilePath;
    private string historyDirectory;
    private string historyIndexPath;
    private int64 historyLimit;
    private int64 conversationCount;
    private int64 conversationLimit;
    private string conversations;
    private string channelsToJoin;
    private string knownUsers;
    private string outbound;
    private int64 outboundDepth;
    private int64 rateLines;
    private int64 rateBurst;
    private int64 rateTokens;
    private int64 rateLast;
    private bool restoring;
    private Dict<string,string> labels;
    private Dict<string,string> transcripts;
    private Dict<string,string> topics;
    private Dict<string,string> topicSetters;
    private Dict<string,string> names;
    private Dict<string,string> members;
    private Dict<string,string> modes;
    private Dict<string,string> joined;
    private Dict<string,string> away;
    private Dict<string,string> historyPaths;
    private Dict<string,string> historyWritable;
    private Dict<string,string> namesReceiving;

    method IrcNetwork(string id, string firstChannel, string initialNick,
                      string server, string directory, int64 maximum) {
        files = new FileTree();
        identifier = cat(id, "");
        displayName = cat(id, "");
        files.text("status", "disconnected\n", false);
        files.text("lasterror", "", false);
        files.text("nextattempt", "0\n", false);
        files.text("events", "", false);
        files.text("statuslog", "", false);
        files.text("conversations", "", false);
        files.text("knownusers", "", false);
        files.text("queue", "0\n", false);
        files.dir("channels");
        files.dir("users");
        // Legacy selected-channel files remain readable for older clients.
        files.text("channel", "", false);
        files.text("transcript", "", false);
        files.text("topic", "", false);
        files.text("topicsetter", "", false);
        files.text("nicks", "", false);
        files.text("modes", "", false);
        files.text("historypath", "", false);
        files.text("historystatus", "disabled\n", false);
        profilePath = cat(directory, "/connection");
        Task<string> savedProfile = spawn IrcProfileLoadRaw(profilePath);
        string profile = savedProfile.take();
        Task<bool> validProfile = spawn IrcProfileValidRaw(profile);
        if(!validProfile.take()) {
            profile.dispose();
            profile = "\t6667\t\t\t";
        }
        files.text("profile", profile, false);
        files.text("name", cat(identifier, "\n"), false);
        files.register(cat("o9irc.network.", identifier));
        fd = "";
        channel = "";
        activeKey = "";
        activeTarget = "";
        nick = initialNick;
        registrationBase = cat(initialNick, "");
        nickFallbacks = 0;
        registered = false;
        wantConnected = len(server) > 0;
        linkUp = false;
        shuttingDown = false;
        supervisorStarted = false;
        generation = 0;
        attempt = 0;
        maxAttempts = 0;
        backoffSec = 1;
        nextAttemptSec = 0;
        lastIncomingSec = 0;
        lastPingSec = 0;
        lastError = "";
        statusText = "disconnected";
        events = "";
        statuslog = "";
        address = server;
        realName = "";
        transport = "tcp";
        trustPath = "";
        serverHost = "";
        historyDirectory = directory;
        historyIndexPath = "";
        historyLimit = maximum;
        conversationCount = 0;
        conversationLimit = 64;
        conversations = "";
        channelsToJoin = "";
        knownUsers = "";
        outbound = "";
        outboundDepth = 0;
        rateLines = 2;
        rateBurst = 5;
        rateTokens = 5000;
        rateLast = 0;
        restoring = false;
        Task<int64> configuredLimit = spawn IrcConversationLimitRaw(
            getenv("o9ircmaxconversations"));
        Task<int64> configuredRate = spawn IrcRateValueRaw(
            getenv("o9ircratelimit"), 2, 20);
        Task<int64> configuredBurst = spawn IrcRateValueRaw(
            getenv("o9ircrateburst"), 5, 50);
        Task<int64> configuredAttempts = spawn IrcAttemptLimitRaw(
            getenv("o9ircmaxattempts"));
        conversationLimit = configuredLimit.take();
        rateLines = configuredRate.take();
        rateBurst = configuredBurst.take();
        maxAttempts = configuredAttempts.take();
        if(historyLimit > 0) {
            Task<int64> directoryReady = spawn FileMkdirAllRaw(historyDirectory);
            if(directoryReady.take() != 0) {
                Task<string> indexPath = spawn IrcHistoryIndexPathRaw(historyDirectory, address);
                historyIndexPath = indexPath.take();
                restoreHistoryIndex();
            }
        }
        if(len(firstChannel) > 0) {
            Task<bool> valid = spawn IrcValidTargetRaw(firstChannel);
            Task<bool> isChannel = spawn IrcIsChannelRaw(firstChannel);
            bool allowed = valid.take();
            bool room = isChannel.take();
            if(allowed && room) {
                string key = ensureConversation("channels", firstChannel);
                if(len(key) > 0) {
                    channel = firstChannel;
                    activeKey = key;
                    activeTarget = cat(firstChannel, "");
                    joined[key] = "yes";
                    showLegacyChannel(key);
                }
            }
        }
    }

    internal method void restoreHistoryIndex() {
        Task<string> savedIndex = spawn IrcHistoryIndexLoadRaw(historyIndexPath);
        string saved = savedIndex.take();
        Task<int64> count = spawn StringCountRaw(saved, "\n");
        int64 rows = count.take();
        restoring = true;
        int64 i = 0;
        while(i < rows && i < conversationLimit) {
            Task<string> row = spawn StringFieldRaw(saved, "\n", i);
            string entry = row.take();
            Task<string> key = spawn StringFieldRaw(entry, "\t", 0);
            Task<string> name = spawn StringFieldRaw(entry, "\t", 1);
            string previousKey = key.take();
            string target = name.take();
            Task<int64> channelPrefix = spawn StringStartsWithRaw(previousKey, "channels/");
            Task<int64> userPrefix = spawn StringStartsWithRaw(previousKey, "users/");
            int64 isChannel = channelPrefix.take();
            int64 isUser = userPrefix.take();
            if(isChannel != 0) { ensureConversation("channels", target); }
            else if(isUser != 0) { ensureConversation("users", target); }
            entry.dispose();
            previousKey.dispose();
            target.dispose();
            i = i + 1;
        }
        saved.dispose();
        restoring = false;
    }

    internal method string ensureConversation(string kind, string target) {
        Task<bool> valid = spawn IrcValidTargetRaw(target);
        if(!valid.take()) { return ""; }
        Task<string> encoded = spawn IrcViewKeyRaw(target);
        string code = encoded.take();
        string prefix = cat(kind, "/");
        string key = cat(prefix, code);
        prefix.dispose();
        code.dispose();
        if(labels.Has(key)) { return key; }
        if(conversationCount >= conversationLimit) {
            appendStatus("o9irc: conversation limit reached");
            return "";
        }
        files.dir(key);
        files.text(cat(key, "/name"), cat(target, "\n"), false);
        files.text(cat(key, "/kind"), cat(kind, "\n"), false);
        files.text(cat(key, "/transcript"), "", false);
        files.text(cat(key, "/topic"), "", false);
        files.text(cat(key, "/topicsetter"), "", false);
        files.text(cat(key, "/nicks"), "", false);
        files.text(cat(key, "/modes"), "", false);
        if(cmp(kind, "users") == 0) {
            Task<string> knownUser = spawn IrcUserRowFieldRaw(knownUsers, target, 1);
            Task<string> knownHost = spawn IrcUserRowFieldRaw(knownUsers, target, 2);
            Task<string> knownAccount = spawn IrcUserRowFieldRaw(knownUsers, target, 3);
            Task<string> knownAway = spawn IrcUserRowFieldRaw(knownUsers, target, 4);
            string initialUser = knownUser.take();
            string initialHost = knownHost.take();
            string initialAccount = knownAccount.take();
            string initialAway = knownAway.take();
            files.text(cat(key, "/user"), cat(initialUser, "\n"), false);
            files.text(cat(key, "/host"), cat(initialHost, "\n"), false);
            files.text(cat(key, "/account"), cat(initialAccount, "\n"), false);
            if(len(initialAway) == 0) {
                initialAway.dispose();
                initialAway = "no";
            }
            files.text(cat(key, "/away"), cat(initialAway, "\n"), false);
            initialUser.dispose();
            initialHost.dispose();
            initialAccount.dispose();
            initialAway.dispose();
        }
        files.text(cat(key, "/historypath"), "", false);
        files.text(cat(key, "/historystatus"), "disabled\n", false);
        labels[key] = target;
        transcripts[key] = "";
        topics[key] = "";
        topicSetters[key] = "";
        names[key] = "";
        members[key] = "";
        modes[key] = "";
        joined[key] = "no";
        away[key] = "no";
        historyPaths[key] = "";
        historyWritable[key] = "no";
        namesReceiving[key] = "no";
        conversationCount = conversationCount + 1;
        string keyTab = cat(key, "\t");
        string targetLine = cat(target, "\n");
        string entry = cat(keyTab, targetLine);
        string nextConversations = cat(conversations, entry);
        keyTab.dispose();
        targetLine.dispose();
        entry.dispose();
        conversations.dispose();
        conversations = nextConversations;
        files.text("conversations", conversations, false);
        if(cmp(kind, "channels") == 0) {
            string joinLine = cat(target, "\n");
            string nextJoins = cat(channelsToJoin, joinLine);
            joinLine.dispose();
            channelsToJoin.dispose();
            channelsToJoin = nextJoins;
        }
        if(!restoring && len(historyIndexPath) > 0) {
            Task<bool> savedIndex = spawn IrcHistoryIndexSaveRaw(historyIndexPath, conversations);
            savedIndex.take();
        }
        loadHistory(key);
        return key;
    }

    internal method void loadHistory(string key) {
        if(historyLimit > 0) {
            Task<int64> directory = spawn FileMkdirAllRaw(historyDirectory);
            if(directory.take() != 0) {
                Task<string> path = spawn IrcHistoryPathRaw(historyDirectory, address, key);
                string name = path.take();
                historyPaths[key] = name;
                Task<string> loaded = spawn IrcHistoryLoadRaw(name);
                string saved = loaded.take();
                Task<int64> exists = spawn FileExistsRaw(name);
                int64 present = exists.take();
                Task<int64> channelPrefix = spawn StringStartsWithRaw(key, "channels/");
                int64 oldChannel = channelPrefix.take();
                if(present == 0 && len(saved) == 0 && oldChannel != 0) {
                    Task<string> oldPath = spawn IrcHistoryPathRaw(historyDirectory, address, labels[key]);
                    string oldName = oldPath.take();
                    Task<string> old = spawn IrcHistoryLoadRaw(oldName);
                    string oldText = old.take();
                    oldName.dispose();
                    saved.dispose();
                    saved = oldText;
                    if(len(saved) > 0) {
                        Task<int64> migrated = spawn IrcHistorySaveRaw(name, saved, historyLimit);
                        migrated.take();
                    }
                }
                if(present != 0 && len(saved) == 0) {
                    files.text(cat(key, "/historystatus"), "cannot read history file\n", false);
                } else {
                    transcripts[key] = saved;
                    files.text(cat(key, "/transcript"), saved, false);
                    historyWritable[key] = "yes";
                    files.text(cat(key, "/historystatus"), "saved\n", false);
                }
                files.text(cat(key, "/historypath"), cat(name, "\n"), false);
                saved.dispose();
                name.dispose();
            } else {
                files.text(cat(key, "/historystatus"), "cannot create history directory\n", false);
            }
        }
    }

    internal method void showLegacyChannel(string key) {
        Task<string> rendered = spawn IrcMembersRenderRaw(members[key]);
        string nicks = rendered.take();
        files.text("channel", cat(channel, "\n"), false);
        files.text("transcript", transcripts[key], false);
        files.text("topic", topics[key], false);
        files.text("topicsetter", topicSetters[key], false);
        files.text("nicks", nicks, false);
        nicks.dispose();
        files.text("modes", modes[key], false);
        files.text("historypath", cat(historyPaths[key], "\n"), false);
        if(cmp(historyWritable[key], "yes") == 0) {
            files.text("historystatus", "saved\n", false);
        } else {
            files.text("historystatus", "disabled\n", false);
        }
    }

    internal method void appendStatus(string line) {
        string suffix = cat(line, "\n");
        string next = cat(statuslog, suffix);
        suffix.dispose();
        statuslog.dispose();
        statuslog = next;
        if(len(statuslog) > 32768) {
            Task<string> tail = spawn StringSliceRaw(statuslog, len(statuslog) - 32768, 32768);
            string clipped = tail.take();
            statuslog.dispose();
            statuslog = clipped;
        }
        files.text("statuslog", statuslog, false);
    }

    // Append one already formatted transcript line. The caller owns `line`.
    internal method bool storeTranscript(string key, string line, bool persist) {
        if(len(key) == 0 || !transcripts.Has(key)) { line.dispose(); return false; }
        string next = cat(transcripts[key], line);
        line.dispose();
        bool stored = false;
        if(persist && cmp(historyWritable[key], "yes") == 0 && historyLimit > 0) {
            bool trying = true;
            while(len(next) > 0 && !stored && trying) {
                Task<int64> saved = spawn IrcHistorySaveRaw(historyPaths[key], next, historyLimit);
                int64 result = saved.take();
                if(result == 1) {
                    stored = true;
                    string statusPath = cat(key, "/historystatus");
                    files.text(statusPath, "saved\n", false);
                    statusPath.dispose();
                } else if(result < 0) {
                    string statusPath = cat(key, "/historystatus");
                    files.text(statusPath, "write failed\n", false);
                    statusPath.dispose();
                    historyWritable[key] = "no";
                    trying = false;
                } else {
                    Task<string> cut = spawn IrcHistoryDropOldRaw(next);
                    string shorter = cut.take();
                    if(len(shorter) >= len(next)) {
                        trying = false;
                        shorter.dispose();
                    } else {
                        next.dispose();
                        next = shorter;
                    }
                }
            }
        }
        if(!stored) {
            bool dropping = true;
            while(len(next) > 32768 && dropping) {
                Task<string> cut = spawn IrcHistoryDropOldRaw(next);
                string shorter = cut.take();
                if(len(shorter) >= len(next)) {
                    dropping = false;
                    shorter.dispose();
                } else {
                    next.dispose();
                    next = shorter;
                }
            }
        }
        transcripts[key] = next;
        string transcriptPath = cat(key, "/transcript");
        files.text(transcriptPath, next, false);
        transcriptPath.dispose();
        if(cmp(key, activeKey) == 0) {
            files.text("transcript", next, false);
        }
        next.dispose();
        return true;
    }

    internal method string nowStamp() {
        Task<int64> now = spawn TimeNowRaw();
        Task<string> stamp = spawn DateTimeStampRaw(now.take());
        return stamp.take();
    }

    internal method bool recordChat(string key, string sender, string body) {
        if(len(key) == 0 || !transcripts.Has(key)) { return false; }
        string time = nowStamp();
        Task<string> formatted = spawn IrcFormatChatRaw(time, sender, body);
        string line = formatted.take();
        time.dispose();
        return storeTranscript(key, line, true);
    }

    internal method bool recordSystem(string key, string text) {
        if(len(key) == 0 || !transcripts.Has(key)) { return false; }
        string time = nowStamp();
        Task<string> formatted = spawn IrcFormatSystemRaw(time, text);
        string line = formatted.take();
        time.dispose();
        return storeTranscript(key, line, false);
    }

    internal method bool recordNotice(string key, string sender, string body) {
        if(len(key) == 0 || !transcripts.Has(key)) { return false; }
        string time = nowStamp();
        Task<string> formatted = spawn IrcFormatNoticeRaw(time, sender, body);
        string line = formatted.take();
        time.dispose();
        return storeTranscript(key, line, true);
    }

    internal method bool recordAction(string key, string sender, string body) {
        if(len(key) == 0 || !transcripts.Has(key)) { return false; }
        string time = nowStamp();
        Task<string> formatted = spawn IrcFormatActionRaw(time, sender, body);
        string line = formatted.take();
        time.dispose();
        return storeTranscript(key, line, true);
    }

    // Refresh the nicks/modes files for one conversation.
    internal method void refreshMembers(string key) {
        if(len(key) > 0 && members.Has(key)) {
            Task<string> rendered = spawn IrcMembersRenderRaw(members[key]);
            string nicks = rendered.take();
            string nicksPath = cat(key, "/nicks");
            files.text(nicksPath, nicks, false);
            if(cmp(key, activeKey) == 0) { files.text("nicks", nicks, false); }
            nicksPath.dispose();
            nicks.dispose();
        }
    }

    internal method void addMember(string key, string nick, string prefixes) {
        if(len(key) > 0 && members.Has(key)) {
            Task<string> updated = spawn IrcMemberUpsertRaw(members[key], nick, prefixes);
            string next = updated.take();
            members[key].dispose();
            members[key] = next;
            refreshMembers(key);
        }
    }

    internal method void removeMember(string key, string nick) {
        if(len(key) > 0 && members.Has(key)) {
            Task<string> updated = spawn IrcMemberRemoveRaw(members[key], nick);
            string next = updated.take();
            members[key].dispose();
            members[key] = next;
            refreshMembers(key);
        }
    }

    internal method void renameMember(string oldNick, string newNick) {
        Task<string> encoded = spawn IrcViewKeyRaw(oldNick);
        Task<string> replacement = spawn IrcViewKeyRaw(newNick);
        string nickKey = encoded.take();
        string newKey = replacement.take();
        if(away.Has(nickKey)) {
            away[newKey] = away[nickKey];
            away[nickKey] = "no";
        }
        nickKey.dispose();
        newKey.dispose();
        Task<int64> total = spawn StringCountRaw(conversations, "\n");
        int64 rows = total.take();
        int64 i = 0;
        while(i < rows) {
            Task<string> keyField = spawn StringFieldRaw(conversations, "\n", i);
            string keyRow = keyField.take();
            Task<string> keyTab = spawn StringFieldRaw(keyRow, "\t", 0);
            string key = keyTab.take();
            keyRow.dispose();
            Task<int64> channelPrefix = spawn StringStartsWithRaw(key, "channels/");
            if(channelPrefix.take() != 0 && members.Has(key)) {
                Task<bool> present = spawn IrcMemberContainsRaw(members[key], oldNick);
                if(present.take()) {
                    Task<string> updated = spawn IrcMemberRenameRaw(members[key], oldNick, newNick);
                    string next = updated.take();
                    members[key].dispose();
                    members[key] = next;
                    refreshMembers(key);
                    string text = cat(cat(cat(oldNick, " is now "), newNick), "");
                    recordSystem(key, text);
                    text.dispose();
                }
            }
            key.dispose();
            i = i + 1;
        }
    }

    // Update one field of the known-user table and mirror the common fields
    // into an existing query conversation for that nick.
    internal method void setUserField(string nick, int64 field, string value) {
        if(len(nick) > 0) {
            Task<string> updated = spawn IrcUserRowUpdateRaw(knownUsers, nick,
                                                            field, value);
            knownUsers.dispose();
            knownUsers = updated.take();
            files.text("knownusers", knownUsers, false);
            Task<string> encoded = spawn IrcViewKeyRaw(nick);
            string code = encoded.take();
            string key = cat("users/", code);
            code.dispose();
            if(labels.Has(key)) {
                string name = "";
                if(field == 1) { name = "user"; }
                else if(field == 2) { name = "host"; }
                else if(field == 3) { name = "account"; }
                else if(field == 4) { name = "away"; }
                if(len(name) > 0) {
                    string path = cat(key, "/");
                    string full = cat(path, name);
                    string line = cat(value, "\n");
                    files.text(full, line, false);
                    path.dispose();
                    full.dispose();
                    line.dispose();
                }
            }
            key.dispose();
        }
    }

    // Track the user/host on any prefixed incoming line. The table is
    // case-folded and shared by channels and queries.
    internal method void trackUser(string line) {
        Task<string> prefixTask = spawn IrcPrefixRaw(line);
        string prefix = prefixTask.take();
        if(len(prefix) > 0) {
            Task<string> nickTask = spawn IrcNickFromPrefixRaw(prefix);
            Task<string> identityTask = spawn IrcUserHostRaw(prefix);
            string who = nickTask.take();
            string identity = identityTask.take();
            if(len(who) > 0 && len(identity) > 0) {
                Task<string> userField = spawn StringFieldRaw(identity, "\t", 0);
                Task<string> hostField = spawn StringFieldRaw(identity, "\t", 1);
                string user = userField.take();
                string host = hostField.take();
                Task<string> oldUserField = spawn IrcUserRowFieldRaw(knownUsers, who, 1);
                Task<string> oldHostField = spawn IrcUserRowFieldRaw(knownUsers, who, 2);
                string oldUser = oldUserField.take();
                string oldHost = oldHostField.take();
                if(cmp(oldUser, user) != 0) { setUserField(who, 1, user); }
                if(cmp(oldHost, host) != 0) { setUserField(who, 2, host); }
                user.dispose();
                host.dispose();
                oldUser.dispose();
                oldHost.dispose();
            }
            who.dispose();
            identity.dispose();
        }
        prefix.dispose();
    }

    internal method void renameKnownUser(string oldNick, string newNick) {
        if(len(oldNick) > 0 && len(newNick) > 0) {
            Task<string> updated = spawn IrcUserRowRenameRaw(knownUsers, oldNick,
                                                            newNick);
            knownUsers.dispose();
            knownUsers = updated.take();
            files.text("knownusers", knownUsers, false);
        }
    }

    internal method void publishQueueDepth() {
        Task<string> depth = spawn IrcIntTextRaw(outboundDepth);
        string count = depth.take();
        string status = cat(count, "\n");
        files.text("queue", status, false);
        count.dispose();
        status.dispose();
    }

    internal method bool enqueueLine(string line) {
        if(len(line) == 0) { return false; }
        if(outboundDepth >= 256) {
            appendStatus("o9irc: outbound queue full; command rejected");
            return false;
        }
        string suffix = cat(line, "\n");
        string next = cat(outbound, suffix);
        suffix.dispose();
        outbound.dispose();
        outbound = next;
        outboundDepth = outboundDepth + 1;
        publishQueueDepth();
        pumpQueue();
        return true;
    }

    internal method void prependOutbound(string line) {
        if(len(line) > 0) {
            string suffix = cat(line, "\n");
            string next = cat(suffix, outbound);
            suffix.dispose();
            outbound.dispose();
            outbound = next;
            outboundDepth = outboundDepth + 1;
            publishQueueDepth();
        }
    }

    // Synchronous token bucket: send immediately while burst tokens remain,
    // then pace the caller. This keeps one owner for the socket.
    internal method void pumpQueue() {
        bool draining = true;
        while(outboundDepth > 0 && draining) {
            Task<int64> nowTask = spawn IrcNowMsRaw();
            int64 now = nowTask.take();
            if(rateLast == 0) { rateLast = now; }
            if(rateLines < 1) { rateLines = 1; }
            rateTokens = rateTokens + (now - rateLast) * rateLines;
            int64 tokenCap = rateBurst * 1000;
            if(rateTokens > tokenCap) { rateTokens = tokenCap; }
            rateLast = now;
            if(rateTokens < 1000) {
                int64 waitMs = (1000 - rateTokens) / rateLines;
                if(waitMs < 1) { waitMs = 1; }
                Task<int64> slept = spawn IrcSleepRaw(waitMs);
                slept.take();
                rateTokens = 1000;
                Task<int64> afterTask = spawn IrcNowMsRaw();
                rateLast = afterTask.take();
            }
            rateTokens = rateTokens - 1000;
            string line = takeOutbound();
            if(len(line) > 0) {
                if(!writeOutbound(line)) {
                    prependOutbound(line);
                    line.dispose();
                    draining = false;
                } else {
                    line.dispose();
                }
            }
        }
    }

    internal method string takeOutbound() {
        string line = "";
        if(outboundDepth > 0 && len(outbound) > 0) {
            Task<string> first = spawn StringFieldRaw(outbound, "\n", 0);
            line = first.take();
            int64 cut = len(line) + 1;
            if(cut >= len(outbound)) {
                outbound.dispose();
                outbound = "";
            } else {
                Task<string> rest = spawn StringSliceRaw(outbound, cut,
                                                        len(outbound) - cut);
                string next = rest.take();
                outbound.dispose();
                outbound = next;
            }
            outboundDepth = outboundDepth - 1;
            Task<string> depth = spawn IrcIntTextRaw(outboundDepth);
            string count = depth.take();
            string status = cat(count, "\n");
            files.text("queue", status, false);
            count.dispose();
            status.dispose();
        }
        return line;
    }

    internal method bool writeOutbound(string line) {
        if(len(fd) == 0 || len(line) == 0) { return false; }
        Task<bool> sent = spawn IrcSend(fd, line);
        return sent.take();
    }

    internal method int64 ratePerSecond() { return rateLines; }
    internal method int64 burstLines() { return rateBurst; }

    internal method void setTopic(string key, string text, string setter) {
        if(len(key) > 0 && topics.Has(key)) {
            topics[key].dispose();
            topics[key] = cat(text, "");
            if(len(setter) > 0) {
                topicSetters[key].dispose();
                topicSetters[key] = cat(setter, "");
            }
            string topicLine = cat(text, "\n");
            string topicPath = cat(key, "/topic");
            files.text(topicPath, topicLine, false);
            string setterLine = cat(setter, "\n");
            string setterPath = cat(key, "/topicsetter");
            files.text(setterPath, setterLine, false);
            if(cmp(key, activeKey) == 0) {
                files.text("topic", topicLine, false);
                files.text("topicsetter", setterLine, false);
            }
            topicPath.dispose();
            setterPath.dispose();
            topicLine.dispose();
            setterLine.dispose();
        }
    }

    internal method void setChannelModes(string key, string value) {
        if(len(key) > 0 && modes.Has(key)) {
            string line = cat("+", value);
            string shown = cat(line, "\n");
            line.dispose();
            modes[key].dispose();
            modes[key] = shown;
            string path = cat(key, "/modes");
            files.text(path, shown, false);
            if(cmp(key, activeKey) == 0) { files.text("modes", shown, false); }
            path.dispose();
            shown.dispose();
        }
    }

    internal method void applyChannelModes(string key, string setter,
                                           string spec, string params) {
        if(len(key) > 0 && modes.Has(key)) {
        Task<string> firstLine = spawn StringFieldRaw(modes[key], "\n", 0);
        string currentLine = firstLine.take();
        string letters = currentLine;
        Task<int64> plus = spawn StringStartsWithRaw(currentLine, "+");
        if(plus.take() != 0) {
            Task<string> rest = spawn StringSliceRaw(currentLine, 1,
                                                     len(currentLine) - 1);
            letters = rest.take();
            currentLine.dispose();
        }
        Task<string> applied = spawn IrcModeApplyRaw(letters, spec);
        string nextModes = applied.take();
        letters.dispose();
        setChannelModes(key, nextModes);
        nextModes.dispose();
        Task<string> changes = spawn IrcModeMemberChangesRaw(spec, params);
        string updates = changes.take();
        Task<int64> rowsTask = spawn StringCountRaw(updates, "\n");
        int64 rows = rowsTask.take();
        int64 i = 0;
        while(i < rows) {
            Task<string> row = spawn StringFieldRaw(updates, "\n", i);
            string entry = row.take();
            Task<string> signField = spawn StringFieldRaw(entry, "\t", 0);
            Task<string> modeField = spawn StringFieldRaw(entry, "\t", 1);
            Task<string> nickField = spawn StringFieldRaw(entry, "\t", 2);
            string sign = signField.take();
            string modeChar = modeField.take();
            string memberNick = nickField.take();
            if(len(memberNick) > 0) {
                Task<string> prefixesTask = spawn IrcMemberPrefixRaw(members[key], memberNick);
                string prefixes = prefixesTask.take();
                Task<string> updated = spawn IrcPrefixApplyRaw(prefixes, sign, modeChar);
                string nextPrefixes = updated.take();
                addMember(key, memberNick, nextPrefixes);
                prefixes.dispose();
                nextPrefixes.dispose();
            }
            sign.dispose();
            modeChar.dispose();
            memberNick.dispose();
            entry.dispose();
            i = i + 1;
        }
        updates.dispose();
        string text = cat(cat(setter, " sets mode "), spec);
        if(len(params) > 0) {
            string withParams = cat(cat(text, " "), params);
            text.dispose();
            text = withParams;
        }
        recordSystem(key, text);
        text.dispose();
        }
    }

    internal method void whoisReply(string commandName, string payload) {
        Task<string> nickField = spawn StringFieldRaw(payload, " ", 2);
        string targetNick = nickField.take();
        if(len(targetNick) > 0) {
        string key = ensureConversation("users", targetNick);
        string text = "";
        if(len(key) > 0) {
            if(cmp(commandName, "311") == 0) {
                Task<string> userField = spawn StringFieldRaw(payload, " ", 3);
                Task<string> hostField = spawn StringFieldRaw(payload, " ", 4);
                Task<string> realField = spawn IrcTrailingRaw(payload);
                string user = userField.take();
                string host = hostField.take();
                string real = realField.take();
                text = cat(cat(cat(cat(targetNick, " is "), user), "@"), host);
                string withReal = cat(cat(text, " ("), cat(real, ")"));
                text.dispose();
                text = withReal;
                setUserField(targetNick, 1, user);
                setUserField(targetNick, 2, host);
                user.dispose();
                host.dispose();
                real.dispose();
            } else if(cmp(commandName, "312") == 0) {
                Task<string> serverField = spawn StringFieldRaw(payload, " ", 3);
                Task<string> infoField = spawn IrcTrailingRaw(payload);
                string server = serverField.take();
                string info = infoField.take();
                text = cat(cat(cat(targetNick, " is on "), server), ": ");
                string full = cat(text, info);
                text.dispose();
                text = full;
                server.dispose();
                info.dispose();
            } else if(cmp(commandName, "313") == 0) {
                text = cat(targetNick, " is an IRC operator");
            } else if(cmp(commandName, "317") == 0) {
                Task<string> idleField = spawn StringFieldRaw(payload, " ", 3);
                string idle = idleField.take();
                text = cat(cat(cat(targetNick, " idle for "), idle), " seconds");
                idle.dispose();
            } else if(cmp(commandName, "319") == 0) {
                Task<string> channelsField = spawn IrcTrailingRaw(payload);
                string rooms = channelsField.take();
                text = cat(cat(targetNick, " is on "), rooms);
                rooms.dispose();
            } else if(cmp(commandName, "330") == 0) {
                Task<string> accountField = spawn StringFieldRaw(payload, " ", 3);
                string account = accountField.take();
                text = cat(cat(cat(targetNick, " is logged in as "), account), "");
                setUserField(targetNick, 3, account);
                account.dispose();
            } else if(cmp(commandName, "301") == 0) {
                Task<string> awayField = spawn IrcTrailingRaw(payload);
                string awayText = awayField.take();
                text = cat(cat(cat(targetNick, " is away: "), awayText), "");
                setUserField(targetNick, 4, "yes");
                awayText.dispose();
            } else if(cmp(commandName, "671") == 0) {
                text = cat(targetNick, " is using a secure connection");
            }
            if(len(text) > 0) { recordSystem(key, text); }
        }
        text.dispose();
        key.dispose();
        }
        targetNick.dispose();
    }

    internal method string channelKey() {
        Task<string> encoded = spawn IrcViewKeyRaw(channel);
        return encoded.take();
    }

    internal method void writeStatus(string value) {
        statusText.dispose();
        statusText = cat(value, "");
        files.text("status", cat(value, "\n"), false);
    }

    internal method void writeLastError(string value) {
        lastError.dispose();
        lastError = cat(value, "");
        files.text("lasterror", cat(value, "\n"), false);
    }

    internal method void publishNextAttempt(int64 seconds) {
        Task<string> text = spawn IrcIntTextRaw(seconds);
        string value = text.take();
        files.text("nextattempt", cat(value, "\n"), false);
        value.dispose();
    }

    internal method int64 nowSeconds() {
        Task<int64> now = spawn TimeNowRaw();
        return now.take();
    }

    internal method void closeSocket() {
        if(len(fd) > 0) {
            Task<int64> stopped = spawn NetCloseRaw(fd);
            stopped.take();
            fd.dispose();
            fd = "";
        }
        linkUp = false;
        outbound.dispose();
        outbound = "";
        outboundDepth = 0;
        files.text("queue", "0\n", false);
    }

    internal method int64 connected(string token) {
        if(len(fd) > 0) { closeSocket(); }
        fd = token;
        linkUp = true;
        generation = generation + 1;
        registered = false;
        nickFallbacks = 0;
        lastIncomingSec = nowSeconds();
        lastPingSec = 0;
        writeStatus("connecting");
        return generation;
    }

    internal method void markRegistered() {
        registered = true;
        attempt = 0;
        backoffSec = 1;
        nextAttemptSec = 0;
        publishNextAttempt(0);
        writeLastError("");
        writeStatus("connected");
    }

    internal method void scheduleReconnect(string message) {
        closeSocket();
        generation = generation + 1;
        registered = false;
        writeLastError(message);
        if(maxAttempts > 0 && attempt >= maxAttempts) {
            wantConnected = false;
            writeStatus("disconnected");
            publishNextAttempt(0);
            writeLastError("reconnect attempts exhausted");
        } else {
            attempt = attempt + 1;
            int64 delay = backoffSec;
            Task<int64> nextBackoff = spawn IrcBackoffNextRaw(backoffSec);
            backoffSec = nextBackoff.take();
            int64 now = nowSeconds();
            nextAttemptSec = now + delay + (now % 3);
            publishNextAttempt(nextAttemptSec);
            writeStatus("reconnecting");
        }
    }

    internal method void linkLost(int64 gen, string message) {
        if(gen == generation) {
            closeSocket();
            if(shuttingDown) {
                writeStatus("closed");
                publishNextAttempt(0);
            } else if(!wantConnected) {
                writeStatus("disconnected");
                publishNextAttempt(0);
            } else {
                scheduleReconnect(message);
            }
        }
    }

    internal method void connectionFailed(string message) {
        closeSocket();
        if(shuttingDown) {
            writeStatus("closed");
            publishNextAttempt(0);
        } else if(!wantConnected) {
            writeStatus("disconnected");
            publishNextAttempt(0);
        } else {
            scheduleReconnect(message);
        }
    }

    internal method bool wantsConnection() { return wantConnected && !shuttingDown; }
    internal method bool retryDue() {
        if(!wantConnected || shuttingDown || linkUp) { return false; }
        return nowSeconds() >= nextAttemptSec;
    }

    internal method void beginConnect() {
        writeStatus("connecting");
        nextAttemptSec = 0;
        publishNextAttempt(0);
        writeLastError("");
    }

    internal method void requestConnect() {
        shuttingDown = false;
        if(len(address) == 0) {
            wantConnected = false;
            writeLastError("no server configured");
            writeStatus("disconnected");
        } else {
            if(!wantConnected) {
                attempt = 0;
                backoffSec = 1;
            }
            wantConnected = true;
            if(!linkUp) { writeStatus("connecting"); }
        }
    }

    internal method void requestDisconnect() {
        wantConnected = false;
        shuttingDown = false;
        attempt = 0;
        backoffSec = 1;
        nextAttemptSec = 0;
        publishNextAttempt(0);
        generation = generation + 1;
        closeSocket();
        writeStatus("disconnected");
    }

    internal method void requestReconnect() {
        shuttingDown = false;
        if(len(address) == 0) {
            wantConnected = false;
            writeLastError("no server configured");
            writeStatus("disconnected");
        } else {
            wantConnected = true;
            attempt = 0;
            backoffSec = 1;
            nextAttemptSec = 0;
            publishNextAttempt(0);
            generation = generation + 1;
            closeSocket();
            writeStatus("reconnecting");
        }
    }

    internal method void shutDownService() {
        shuttingDown = true;
        wantConnected = false;
        generation = generation + 1;
        closeSocket();
        writeStatus("closed");
        publishNextAttempt(0);
    }

    internal method bool claimSupervisor() {
        if(supervisorStarted) { return false; }
        supervisorStarted = true;
        return true;
    }

    internal method void applyTransport(string nextTransport, string host,
                                        string trust) {
        transport.dispose();
        serverHost.dispose();
        trustPath.dispose();
        transport = cat(nextTransport, "");
        serverHost = cat(host, "");
        trustPath = cat(trust, "");
    }

    internal method void markIncoming() {
        lastIncomingSec = nowSeconds();
        lastPingSec = 0;
    }

    internal method int64 watchdogTick(int64 gen) {
        int64 result = 1;
        if(gen != generation || !linkUp) {
            result = 0;
        } else {
            int64 now = nowSeconds();
            if(now - lastIncomingSec >= 120) {
                scheduleReconnect("ping timeout");
                result = 0;
            } else if(now - lastIncomingSec >= 60 &&
                      (lastPingSec == 0 || now - lastPingSec >= 60)) {
                Task<bool> sent = spawn IrcSend(fd, "PING :o9irc");
                sent.take();
                lastPingSec = now;
            }
        }
        return result;
    }

    internal method void closed() {
        shutDownService();
    }

    internal method void loadStoredProfile() {
        Task<string> saved = spawn IrcProfileLoadRaw(profilePath);
        string value = saved.take();
        Task<bool> valid = spawn IrcProfileValidRaw(value);
        if(valid.take()) {
            configure(value, false);
        }
        value.dispose();
    }

    internal method string networkId() { return cat(identifier, ""); }
    internal method string networkStatus() { return cat(statusText, ""); }
    internal method void markRemoved() {
        shuttingDown = true;
        wantConnected = false;
        generation = generation + 1;
        closeSocket();
        writeStatus("removed");
        publishNextAttempt(0);
    }
    internal method string networkName() { return cat(displayName, ""); }
    internal method void setNetworkName(string value) {
        displayName.dispose();
        displayName = cat(value, "");
        files.text("name", cat(value, "\n"), false);
    }

    internal method string connectionAddress() { return cat(address, ""); }
    internal method string connectionNick() { return cat(nick, ""); }
    internal method string connectionName() { return cat(realName, ""); }
    internal method string connectionTransport() { return cat(transport, ""); }
    internal method string connectionTrustPath() { return cat(trustPath, ""); }
    internal method string connectionHost() { return cat(serverHost, ""); }
    internal method void connectionError(string message) { connectionFailed(message); }

    internal method bool configure(string value, bool connectNow) {
        Task<bool> valid = spawn IrcProfileValidRaw(value);
        if(!valid.take()) {
            appendStatus("o9irc: invalid connection settings");
            return false;
        }
        if(connectNow && (linkUp || wantConnected)) {
            appendStatus("o9irc: disconnect before connecting to another server");
            return false;
        }
        Task<int64> directory = spawn FileMkdirAllRaw(historyDirectory);
        if(directory.take() == 0) { return false; }
        Task<bool> saved = spawn IrcProfileSaveRaw(profilePath, value);
        if(!saved.take()) { return false; }
        files.text("profile", value, false);
        if(!connectNow && linkUp) { return true; }
        Task<string> hostPart = spawn StringFieldRaw(value, "\t", 0);
        Task<string> portPart = spawn StringFieldRaw(value, "\t", 1);
        Task<string> nickPart = spawn StringFieldRaw(value, "\t", 2);
        Task<string> channelPart = spawn StringFieldRaw(value, "\t", 3);
        Task<string> namePart = spawn StringFieldRaw(value, "\t", 4);
        Task<string> transportPart = spawn StringFieldRaw(value, "\t", 5);
        Task<string> trustPart = spawn StringFieldRaw(value, "\t", 6);
        string host = hostPart.take();
        string port = portPart.take();
        string nextNick = nickPart.take();
        string nextChannel = channelPart.take();
        string nextName = namePart.take();
        string nextTransport = transportPart.take();
        string nextTrust = trustPart.take();
        string nextAddress = cat(cat(cat("tcp!", host), "!"), port);
        if(len(address) > 0 && (cmp(address, nextAddress) != 0 ||
            cmp(transport, nextTransport) != 0) && conversationCount > 0) {
            appendStatus("o9irc: restart the service before changing servers");
            host.dispose(); port.dispose(); nextNick.dispose(); nextChannel.dispose();
            nextName.dispose(); nextAddress.dispose(); nextTransport.dispose();
            nextTrust.dispose();
            return false;
        }
        bool newServer = cmp(address, nextAddress) != 0 ||
            cmp(transport, nextTransport) != 0;
        address.dispose();
        nick.dispose();
        registrationBase.dispose();
        realName.dispose();
        transport.dispose();
        trustPath.dispose();
        serverHost.dispose();
        address = nextAddress;
        nick = nextNick;
        registrationBase = cat(nextNick, "");
        realName = nextName;
        transport = nextTransport;
        trustPath = nextTrust;
        serverHost = cat(host, "");
        if(newServer && historyLimit > 0) {
            Task<string> indexPath = spawn IrcHistoryIndexPathRaw(historyDirectory, address);
            historyIndexPath.dispose();
            historyIndexPath = indexPath.take();
            restoreHistoryIndex();
        }
        registered = false;
        nickFallbacks = 0;
        if(connectNow) {
            shuttingDown = false;
            wantConnected = true;
            attempt = 0;
            backoffSec = 1;
            nextAttemptSec = 0;
            publishNextAttempt(0);
            writeStatus("connecting");
        }
        if(len(nextChannel) > 0) {
            Task<bool> validChannel = spawn IrcValidTargetRaw(nextChannel);
            Task<bool> isChannel = spawn IrcIsChannelRaw(nextChannel);
            bool allowedChannel = validChannel.take();
            bool channelTarget = isChannel.take();
            if(allowedChannel && channelTarget) {
                string key = ensureConversation("channels", nextChannel);
                if(len(key) > 0) {
                    channel.dispose();
                    activeKey.dispose();
                    activeTarget.dispose();
                    channel = nextChannel;
                    activeKey = key;
                    activeTarget = cat(nextChannel, "");
                    joined[key] = "yes";
                    showLegacyChannel(key);
                } else {
                    nextChannel.dispose();
                }
            } else {
                appendStatus("o9irc: profile channel is not a channel");
                nextChannel.dispose();
            }
        } else {
            nextChannel.dispose();
        }
        host.dispose();
        port.dispose();
        return true;
    }

    internal method bool incoming(string line) {
        trackUser(line);
        Task<string> parsed = spawn IrcPayload(line);
        string payload = parsed.take();
        Task<string> commandField = spawn StringFieldRaw(payload, " ", 0);
        string commandName = commandField.take();
        if(cmp(commandName, "PING") == 0 && len(fd) > 0) {
            Task<string> parameter = spawn StringSliceRaw(payload, 5, len(payload) - 5);
            string token = parameter.take();
            string response = cat("PONG ", token);
            Task<bool> pong = spawn IrcSend(fd, response);
            pong.take();
            response.dispose();
            token.dispose();
        }
        if(cmp(commandName, "001") == 0 && len(fd) > 0) {
            markRegistered();
            Task<string> assignedField = spawn StringFieldRaw(payload, " ", 1);
            string assigned = assignedField.take();
            if(len(assigned) > 0) {
                nick.dispose();
                nick = assigned;
            } else {
                assigned.dispose();
            }
            // Rejoin only the conversations still marked joined. PART clears
            // the flag, so a manual part survives a reconnect.
            Task<int64> lineCount = spawn StringCountRaw(conversations, "\n");
            int64 lines = lineCount.take();
            int64 i = 0;
            while(i < lines) {
                Task<string> keyField = spawn StringFieldRaw(conversations, "\n", i);
                string keyRow = keyField.take();
                Task<string> keyTab = spawn StringFieldRaw(keyRow, "\t", 0);
                string key = keyTab.take();
                keyRow.dispose();
                Task<int64> channelPrefix = spawn StringStartsWithRaw(key, "channels/");
                if(channelPrefix.take() != 0 && joined.Has(key) &&
                   cmp(joined[key], "yes") == 0) {
                    string room = cat(labels[key], "");
                    string request = cat("JOIN ", room);
                    enqueueLine(request);
                    request.dispose();
                    room.dispose();
                }
                key.dispose();
                i = i + 1;
            }
        }
        if((cmp(commandName, "433") == 0 || cmp(commandName, "437") == 0) &&
           !registered && len(fd) > 0) {
            if(nickFallbacks < 9) {
                nickFallbacks = nickFallbacks + 1;
                Task<string> candidate = spawn IrcNickFallbackRaw(registrationBase, nickFallbacks);
                string nextNick = candidate.take();
                string request = cat("NICK ", nextNick);
                Task<bool> sent = spawn IrcSend(fd, request);
                if(sent.take()) {
                    string notice = cat("o9irc: nickname in use; trying ", nextNick);
                    appendStatus(notice);
                    notice.dispose();
                    nick.dispose();
                    nick = nextNick;
                } else { nextNick.dispose(); }
                request.dispose();
            } else {
                appendStatus("o9irc: fallback nicknames exhausted; enter /nick name");
            }
        }
        string eventLine = cat(line, "\n");
        string combined = cat(events, eventLine);
        eventLine.dispose();
        events.dispose();
        events = combined;
        if(len(events) > 32768) {
            Task<string> tail = spawn StringSliceRaw(events, len(events) - 32768, 32768);
            string clipped = tail.take();
            events.dispose();
            events = clipped;
        }
        files.text("events", events, false);
        if(cmp(commandName, "PRIVMSG") == 0) {
            Task<string> targetField = spawn StringFieldRaw(payload, " ", 1);
            Task<string> senderField = spawn IrcSenderRaw(line);
            Task<string> bodyField = spawn IrcTrailingRaw(payload);
            string target = targetField.take();
            string sender = senderField.take();
            string body = bodyField.take();
            Task<bool> isChannel = spawn IrcIsChannelRaw(target);
            string key = "";
            if(isChannel.take()) {
                key = ensureConversation("channels", target);
            } else if(len(sender) > 0) {
                key = ensureConversation("users", sender);
            }
            if(len(key) > 0) {
                Task<string> actionField = spawn IrcActionTextRaw(body);
                string action = actionField.take();
                if(len(action) > 0) {
                    recordAction(key, sender, action);
                } else {
                    recordChat(key, sender, body);
                }
                action.dispose();
            } else {
                appendStatus(line);
            }
            key.dispose();
            target.dispose();
            sender.dispose();
            body.dispose();
            payload.dispose();
            commandName.dispose();
            return true;
        }
        if(cmp(commandName, "NOTICE") == 0) {
            Task<string> targetField = spawn StringFieldRaw(payload, " ", 1);
            Task<string> senderField = spawn IrcSenderRaw(line);
            Task<string> bodyField = spawn IrcTrailingRaw(payload);
            string target = targetField.take();
            string sender = senderField.take();
            string body = bodyField.take();
            Task<bool> isChannel = spawn IrcIsChannelRaw(target);
            string key = "";
            if(isChannel.take()) {
                key = ensureConversation("channels", target);
            } else if(len(sender) > 0) {
                key = ensureConversation("users", sender);
            }
            if(len(key) > 0 && len(body) > 0) {
                recordNotice(key, sender, body);
            } else {
                appendStatus(line);
            }
            key.dispose();
            target.dispose();
            sender.dispose();
            body.dispose();
            payload.dispose();
            commandName.dispose();
            return true;
        }
        if(cmp(commandName, "JOIN") == 0) {
            Task<string> targetField = spawn StringFieldRaw(payload, " ", 1);
            Task<string> trailingField = spawn IrcTrailingRaw(payload);
            Task<string> senderField = spawn IrcSenderRaw(line);
            string room = trailingField.take();
            string sender = senderField.take();
            if(len(room) == 0) {
                room.dispose();
                room = targetField.take();
            } else {
                string unusedRoom = targetField.take();
                unusedRoom.dispose();
            }
            string key = ensureConversation("channels", room);
            if(len(key) > 0) {
                addMember(key, sender, "");
                joined[key] = "yes";
                string text = cat(sender, " joined");
                recordSystem(key, text);
                text.dispose();
                Task<bool> isSelf = spawn IrcNickEqualRaw(sender, nick);
                if(isSelf.take()) {
                    channel.dispose();
                    activeKey.dispose();
                    activeTarget.dispose();
                    channel = cat(room, "");
                    activeKey = cat(key, "");
                    activeTarget = cat(room, "");
                    showLegacyChannel(key);
                }
            }
            key.dispose();
            room.dispose();
            sender.dispose();
        }
        if(cmp(commandName, "PART") == 0) {
            Task<string> targetField = spawn StringFieldRaw(payload, " ", 1);
            Task<string> senderField = spawn IrcSenderRaw(line);
            Task<string> reasonField = spawn IrcTrailingRaw(payload);
            string room = targetField.take();
            string sender = senderField.take();
            string reason = reasonField.take();
            string key = ensureConversation("channels", room);
            if(len(key) > 0) {
                removeMember(key, sender);
                Task<bool> isSelf = spawn IrcNickEqualRaw(sender, nick);
                bool own = isSelf.take();
                if(own && joined.Has(key)) { joined[key] = "no"; }
                string text = cat(sender, " left");
                if(len(reason) > 0) {
                    string withReason = cat(cat(cat(text, " ("), reason), ")");
                    text.dispose();
                    text = withReason;
                }
                recordSystem(key, text);
                text.dispose();
                if(own) {
                    channel.dispose();
                    activeKey.dispose();
                    activeTarget.dispose();
                    channel = "";
                    activeKey = "";
                    activeTarget = "";
                }
            }
            key.dispose();
            room.dispose();
            sender.dispose();
            reason.dispose();
        }
        if(cmp(commandName, "QUIT") == 0) {
            Task<string> senderField = spawn IrcSenderRaw(line);
            Task<string> reasonField = spawn IrcTrailingRaw(payload);
            string sender = senderField.take();
            string reason = reasonField.take();
            Task<int64> total = spawn StringCountRaw(conversations, "\n");
            int64 rows = total.take();
            int64 i = 0;
            while(i < rows) {
                Task<string> keyField = spawn StringFieldRaw(conversations, "\n", i);
                string keyRow = keyField.take();
                Task<string> keyTab = spawn StringFieldRaw(keyRow, "\t", 0);
                string key = keyTab.take();
                keyRow.dispose();
                Task<int64> channelPrefix = spawn StringStartsWithRaw(key, "channels/");
                if(channelPrefix.take() != 0 && members.Has(key)) {
                    Task<bool> present = spawn IrcMemberContainsRaw(members[key], sender);
                    if(present.take()) {
                        removeMember(key, sender);
                        string text = cat(sender, " quit");
                        if(len(reason) > 0) {
                            string withReason = cat(cat(cat(text, " ("), reason), ")");
                            text.dispose();
                            text = withReason;
                        }
                        recordSystem(key, text);
                        text.dispose();
                    }
                }
                key.dispose();
                i = i + 1;
            }
            sender.dispose();
            reason.dispose();
        }
        if(cmp(commandName, "KICK") == 0) {
            Task<string> targetField = spawn StringFieldRaw(payload, " ", 1);
            Task<string> victimField = spawn StringFieldRaw(payload, " ", 2);
            Task<string> senderField = spawn IrcSenderRaw(line);
            Task<string> reasonField = spawn IrcTrailingRaw(payload);
            string room = targetField.take();
            string victim = victimField.take();
            string sender = senderField.take();
            string reason = reasonField.take();
            string key = ensureConversation("channels", room);
            if(len(key) > 0) {
                removeMember(key, victim);
                string text = cat(cat(cat(sender, " kicked "), victim), "");
                if(len(reason) > 0) {
                    string withReason = cat(cat(cat(text, " ("), reason), ")");
                    text.dispose();
                    text = withReason;
                }
                recordSystem(key, text);
                text.dispose();
                Task<bool> isSelf = spawn IrcNickEqualRaw(victim, nick);
                if(isSelf.take() && joined.Has(key)) {
                    joined[key] = "no";
                    channel.dispose();
                    activeKey.dispose();
                    activeTarget.dispose();
                    channel = "";
                    activeKey = "";
                    activeTarget = "";
                }
            }
            key.dispose();
            room.dispose();
            victim.dispose();
            sender.dispose();
            reason.dispose();
        }
        if(cmp(commandName, "MODE") == 0) {
            Task<string> targetField = spawn StringFieldRaw(payload, " ", 1);
            Task<string> specField = spawn StringFieldRaw(payload, " ", 2);
            Task<string> senderField = spawn IrcSenderRaw(line);
            Task<string> paramsField = spawn IrcFieldsFromRaw(payload, 3);
            string target = targetField.take();
            string spec = specField.take();
            string sender = senderField.take();
            string params = paramsField.take();
            Task<bool> isChannel = spawn IrcIsChannelRaw(target);
            if(isChannel.take() && len(spec) > 0) {
                Task<string> encoded = spawn IrcViewKeyRaw(target);
                string key = cat("channels/", encoded.take());
                if(modes.Has(key)) { applyChannelModes(key, sender, spec, params); }
                key.dispose();
            }
            target.dispose();
            spec.dispose();
            sender.dispose();
            params.dispose();
        }
        if(cmp(commandName, "332") == 0 || cmp(commandName, "TOPIC") == 0) {
            int64 field = 1;
            if(cmp(commandName, "332") == 0) { field = 2; }
            Task<string> target = spawn StringFieldRaw(payload, " ", field);
            Task<string> value = spawn IrcTrailingRaw(payload);
            Task<string> setterField = spawn IrcSenderRaw(line);
            string room = target.take();
            string topicText = value.take();
            string setter = setterField.take();
            string key = ensureConversation("channels", room);
            if(len(key) > 0) {
                setTopic(key, topicText, setter);
                if(cmp(commandName, "TOPIC") == 0) {
                    string text = cat(setter, " changed the topic");
                    if(len(topicText) > 0) {
                        string withTopic = cat(cat(text, ": "), topicText);
                        text.dispose();
                        text = withTopic;
                    }
                    recordSystem(key, text);
                    text.dispose();
                }
            }
            key.dispose();
            room.dispose();
            topicText.dispose();
            setter.dispose();
        }
        if(cmp(commandName, "333") == 0) {
            Task<string> target = spawn StringFieldRaw(payload, " ", 2);
            Task<string> setterField = spawn StringFieldRaw(payload, " ", 3);
            string room = target.take();
            string setter = setterField.take();
            string key = ensureConversation("channels", room);
            if(len(key) > 0 && len(setter) > 0) {
                setTopic(key, topics[key], setter);
            }
            key.dispose();
            room.dispose();
            setter.dispose();
        }
        if(cmp(commandName, "353") == 0) {
            Task<string> target = spawn StringFieldRaw(payload, " ", 3);
            string room = target.take();
            string key = ensureConversation("channels", room);
            room.dispose();
            if(len(key) > 0) {
                if(cmp(namesReceiving[key], "yes") != 0) {
                    members[key].dispose();
                    members[key] = "";
                    namesReceiving[key] = "yes";
                }
                Task<string> value = spawn IrcTrailingRaw(payload);
                string rawNames = value.take();
                Task<int64> gaps = spawn StringCountRaw(rawNames, " ");
                int64 count = gaps.take() + 1;
                int64 i = 0;
                while(i < count) {
                    Task<string> token = spawn StringFieldRaw(rawNames, " ", i);
                    string name = token.take();
                    if(len(name) > 0) {
                        Task<string> updated = spawn IrcNamesAddRaw(members[key], name);
                        string next = updated.take();
                        members[key].dispose();
                        members[key] = next;
                    }
                    name.dispose();
                    i = i + 1;
                }
                refreshMembers(key);
                rawNames.dispose();
            }
            key.dispose();
        }
        if(cmp(commandName, "366") == 0) {
            Task<string> target = spawn StringFieldRaw(payload, " ", 2);
            string targetText = target.take();
            Task<string> encoded = spawn IrcViewKeyRaw(targetText);
            string encodedText = encoded.take();
            targetText.dispose();
            string key = cat("channels/", encodedText);
            encodedText.dispose();
            if(namesReceiving.Has(key)) {
                namesReceiving[key] = "no";
                refreshMembers(key);
            }
            key.dispose();
        }
        if(cmp(commandName, "NICK") == 0) {
            Task<string> sender = spawn IrcSenderRaw(line);
            Task<string> replacement = spawn IrcTrailingRaw(payload);
            string oldNick = sender.take();
            string newNick = replacement.take();
            if(len(newNick) == 0) {
                newNick.dispose();
                Task<string> parameter = spawn StringFieldRaw(payload, " ", 1);
                newNick = parameter.take();
            }
            if(len(newNick) > 0 && len(oldNick) > 0) {
                renameMember(oldNick, newNick);
                renameKnownUser(oldNick, newNick);
                Task<bool> isSelf = spawn IrcNickEqualRaw(oldNick, nick);
                if(isSelf.take()) {
                    nick.dispose();
                    nick = cat(newNick, "");
                }
            }
            oldNick.dispose();
            newNick.dispose();
        }
        if(cmp(commandName, "AWAY") == 0) {
            Task<string> sender = spawn IrcSenderRaw(line);
            Task<string> message = spawn IrcTrailingRaw(payload);
            string who = sender.take();
            string awayText = message.take();
            Task<string> encoded = spawn IrcViewKeyRaw(who);
            string key = encoded.take();
            if(away.Has(key)) {
                if(len(awayText) > 0) { away[key] = "yes"; } else { away[key] = "no"; }
            }
            if(len(awayText) > 0) { setUserField(who, 4, "yes"); }
            else { setUserField(who, 4, "no"); }
            key.dispose();
            Task<bool> isSelf = spawn IrcNickEqualRaw(who, nick);
            if(isSelf.take()) {
                if(len(awayText) > 0) { appendStatus("o9irc: you are marked away"); }
                else { appendStatus("o9irc: you are no longer away"); }
            }
            who.dispose();
            awayText.dispose();
        }
        if(cmp(commandName, "305") == 0) {
            setUserField(nick, 4, "no");
            appendStatus("o9irc: you are no longer away");
        }
        if(cmp(commandName, "306") == 0) {
            setUserField(nick, 4, "yes");
            appendStatus("o9irc: you are marked away");
        }
        if(cmp(commandName, "ACCOUNT") == 0) {
            Task<string> sender = spawn IrcSenderRaw(line);
            Task<string> accountField = spawn IrcTrailingRaw(payload);
            string who = sender.take();
            string account = accountField.take();
            if(len(who) > 0) {
                if(len(account) > 0) { setUserField(who, 3, account); }
                else { setUserField(who, 3, ""); }
            }
            who.dispose();
            account.dispose();
        }
        if(cmp(commandName, "CHGHOST") == 0) {
            Task<string> sender = spawn IrcSenderRaw(line);
            Task<string> userField = spawn StringFieldRaw(payload, " ", 1);
            Task<string> hostField = spawn StringFieldRaw(payload, " ", 2);
            string who = sender.take();
            string user = userField.take();
            string host = hostField.take();
            if(len(who) > 0) {
                if(len(user) > 0) { setUserField(who, 1, user); }
                if(len(host) > 0) { setUserField(who, 2, host); }
            }
            who.dispose();
            user.dispose();
            host.dispose();
        }
        if(cmp(commandName, "311") == 0 || cmp(commandName, "312") == 0 ||
           cmp(commandName, "313") == 0 || cmp(commandName, "317") == 0 ||
           cmp(commandName, "319") == 0 || cmp(commandName, "330") == 0 ||
           cmp(commandName, "301") == 0 || cmp(commandName, "671") == 0) {
            whoisReply(commandName, payload);
        }
        if(cmp(commandName, "INVITE") == 0) {
            Task<string> sender = spawn IrcSenderRaw(line);
            Task<string> target = spawn StringFieldRaw(payload, " ", 1);
            Task<string> roomField = spawn IrcTrailingRaw(payload);
            string who = sender.take();
            string invited = target.take();
            string room = roomField.take();
            if(len(room) == 0) {
                room.dispose();
                Task<string> fieldRoom = spawn StringFieldRaw(payload, " ", 2);
                room = fieldRoom.take();
            }
            string text = cat(cat(cat(who, " invited "), invited), cat(" to ", room));
            appendStatus(text);
            text.dispose();
            who.dispose();
            invited.dispose();
            room.dispose();
        }
        appendStatus(line);
        payload.dispose();
        commandName.dispose();
        return true;
    }

    // Send one logical message, split into frames that fit the IRC 512-byte
    // limit. Splitting happens on UTF-8 boundaries; each frame is counted in
    // bytes including `PRIVMSG <target> :`.
    internal method bool sendFrames(string target, string verb, string body,
                                    bool action) {
        string prefix = cat(cat(verb, " "), target);
        string lead = cat(prefix, " :");
        prefix.dispose();
        int64 room = 510 - len(lead);
        if(action) { room = room - 9; }
        if(room < 1 || len(body) == 0) {
            lead.dispose();
            return false;
        }
        Task<string> chunks = spawn IrcSplitRaw(body, room);
        string pending = chunks.take();
        Task<int64> rows = spawn StringCountRaw(pending, "\n");
        int64 count = rows.take();
        byte one = 1;
        Task<string> markerTask = spawn BytesAppendRaw("", one);
        string marker = markerTask.take();
        bool ok = count > 0;
        int64 i = 0;
        while(i < count) {
            Task<string> field = spawn StringFieldRaw(pending, "\n", i);
            string chunk = field.take();
            string frameBody = chunk;
            if(action) {
                string tagged = cat(cat(marker, "ACTION "), chunk);
                string closed = cat(tagged, marker);
                tagged.dispose();
                frameBody = closed;
            }
            string request = cat(lead, frameBody);
            if(!enqueueLine(request)) { ok = false; }
            request.dispose();
            if(action) { frameBody.dispose(); }
            chunk.dispose();
            i = i + 1;
        }
        marker.dispose();
        pending.dispose();
        lead.dispose();
        return ok;
    }

    internal method bool command(string input) {
        Task<int64> saveProfile = spawn StringStartsWithRaw(input, "profile\t");
        Task<int64> connectProfile = spawn StringStartsWithRaw(input, "connect\t");
        int64 saving = saveProfile.take();
        int64 connecting = connectProfile.take();
        if(saving != 0 || connecting != 0) {
            Task<string> fields = spawn StringSliceRaw(input, 8, len(input)-8);
            string value = fields.take();
            bool ok = configure(value, connecting != 0);
            value.dispose();
            return ok;
        }
        if(cmp(input, "connect") == 0) {
            requestConnect();
            return true;
        }
        if(cmp(input, "disconnect") == 0) {
            requestDisconnect();
            return true;
        }
        if(cmp(input, "reconnect") == 0) {
            requestReconnect();
            return true;
        }
        if(len(fd) == 0 || len(input) == 0) { return false; }
        Task<int64> join = spawn StringStartsWithRaw(input, "join ");
        Task<int64> isMessage = spawn StringStartsWithRaw(input, "msg ");
        Task<int64> isNick = spawn StringStartsWithRaw(input, "nick ");
        Task<int64> say = spawn StringStartsWithRaw(input, "say ");
        int64 wantJoin = join.take();
        int64 wantMessage = isMessage.take();
        int64 wantNick = isNick.take();
        int64 wantSay = say.take();
        if(wantJoin != 0) {
            Task<string> target = spawn StringSliceRaw(input, 5, len(input) - 5);
            string room = target.take();
            Task<bool> valid = spawn IrcValidTargetRaw(room);
            Task<bool> isChannel = spawn IrcIsChannelRaw(room);
            bool allowed = valid.take();
            bool channelTarget = isChannel.take();
            if(!allowed || !channelTarget) {
                room.dispose();
                return false;
            }
            string key = ensureConversation("channels", room);
            if(len(key) == 0) {
                room.dispose();
                key.dispose();
                return false;
            }
            string request = cat("JOIN ", room);
            bool joinedOk = enqueueLine(request);
            request.dispose();
            if(!joinedOk) {
                room.dispose();
                key.dispose();
                return false;
            }
            joined[key] = "yes";
            channel.dispose();
            activeKey.dispose();
            activeTarget.dispose();
            channel = room;
            activeKey = key;
            activeTarget = cat(room, "");
            showLegacyChannel(key);
            return true;
        }
        if(wantMessage != 0) {
            Task<string> args = spawn StringSliceRaw(input, 4, len(input) - 4);
            string argline = args.take();
            Task<int64> gap = spawn StringIndexOfRaw(argline, " ");
            int64 pos = gap.take();
            if(pos <= 0 || pos >= len(argline) - 1) {
                argline.dispose();
                return false;
            }
            Task<string> target = spawn StringSliceRaw(argline, 0, pos);
            Task<string> body = spawn StringSliceRaw(argline, pos + 1, len(argline) - pos - 1);
            string destination = target.take();
            string words = body.take();
            argline.dispose();
            Task<bool> valid = spawn IrcValidTargetRaw(destination);
            if(!valid.take()) {
                destination.dispose();
                words.dispose();
                return false;
            }
            Task<bool> isChannel = spawn IrcIsChannelRaw(destination);
            string key = "";
            if(isChannel.take()) { key = ensureConversation("channels", destination); }
            else { key = ensureConversation("users", destination); }
            if(len(key) == 0) {
                destination.dispose();
                words.dispose();
                key.dispose();
                return false;
            }
            bool delivered = sendFrames(destination, "PRIVMSG", words, false);
            if(delivered) { recordChat(key, nick, words); }
            key.dispose();
            destination.dispose();
            words.dispose();
            return delivered;
        }
        if(wantNick != 0) {
            Task<string> replacement = spawn StringSliceRaw(input, 5, len(input) - 5);
            string newNick = replacement.take();
            Task<bool> valid = spawn IrcValidTargetRaw(newNick);
            if(!valid.take()) {
                newNick.dispose();
                return false;
            }
            string request = cat("NICK ", newNick);
            bool ok = enqueueLine(request);
            request.dispose();
            newNick.dispose();
            return ok;
        }
        if(wantSay != 0 && len(channel) > 0) {
            Task<string> body = spawn StringSliceRaw(input, 4, len(input) - 4);
            string words = body.take();
            bool delivered = sendFrames(channel, "PRIVMSG", words, false);
            if(!delivered) {
                words.dispose();
                return false;
            }
            recordChat(activeKey, nick, words);
            words.dispose();
            return true;
        }
        Task<int64> notice = spawn StringStartsWithRaw(input, "notice ");
        Task<int64> action = spawn StringStartsWithRaw(input, "me ");
        Task<int64> part = spawn StringStartsWithRaw(input, "part");
        Task<int64> topic = spawn StringStartsWithRaw(input, "topic ");
        Task<int64> mode = spawn StringStartsWithRaw(input, "mode ");
        Task<int64> kick = spawn StringStartsWithRaw(input, "kick ");
        Task<int64> whois = spawn StringStartsWithRaw(input, "whois ");
        Task<int64> awayCommand = spawn StringStartsWithRaw(input, "away");
        Task<int64> invite = spawn StringStartsWithRaw(input, "invite ");
        int64 wantNotice = notice.take();
        int64 wantAction = action.take();
        int64 wantPart = part.take();
        int64 wantTopic = topic.take();
        int64 wantMode = mode.take();
        int64 wantKick = kick.take();
        int64 wantWhois = whois.take();
        int64 wantAway = awayCommand.take();
        int64 wantInvite = invite.take();
        Task<int64> partSepTask = spawn IrcByteAtRaw(input, 4);
        Task<int64> awaySepTask = spawn IrcByteAtRaw(input, 4);
        int64 partSep = partSepTask.take();
        int64 awaySep = awaySepTask.take();
        if(wantNotice != 0) {
            Task<string> args = spawn StringSliceRaw(input, 7, len(input) - 7);
            string argline = args.take();
            Task<int64> gap = spawn StringIndexOfRaw(argline, " ");
            int64 pos = gap.take();
            if(pos <= 0 || pos >= len(argline) - 1) {
                argline.dispose();
                return false;
            }
            Task<string> target = spawn StringSliceRaw(argline, 0, pos);
            Task<string> body = spawn StringSliceRaw(argline, pos + 1,
                                                     len(argline) - pos - 1);
            string destination = target.take();
            string words = body.take();
            argline.dispose();
            Task<bool> valid = spawn IrcValidTargetRaw(destination);
            if(!valid.take()) {
                destination.dispose();
                words.dispose();
                return false;
            }
            Task<bool> isChannel = spawn IrcIsChannelRaw(destination);
            string key = "";
            if(isChannel.take()) { key = ensureConversation("channels", destination); }
            else { key = ensureConversation("users", destination); }
            bool delivered = false;
            if(len(key) > 0) {
                delivered = sendFrames(destination, "NOTICE", words, false);
                if(delivered) { recordNotice(key, nick, words); }
            }
            key.dispose();
            destination.dispose();
            words.dispose();
            return delivered;
        }
        if(wantAction != 0 && len(channel) > 0) {
            Task<string> body = spawn StringSliceRaw(input, 3, len(input) - 3);
            string words = body.take();
            bool delivered = sendFrames(channel, "PRIVMSG", words, true);
            if(delivered && len(activeKey) > 0) {
                recordAction(activeKey, nick, words);
            }
            words.dispose();
            return delivered;
        }
        if(wantPart != 0 && (len(input) == 4 || partSep == 32)) {
            Task<string> args = spawn StringSliceRaw(input, 4, len(input) - 4);
            string argline = args.take();
            Task<string> trimmedTask = spawn StringTrimRaw(argline);
            string trimmed = trimmedTask.take();
            string room = "";
            string reason = "";
            Task<bool> isChannel = spawn IrcIsChannelRaw(trimmed);
            Task<int64> gap = spawn StringIndexOfRaw(trimmed, " ");
            int64 pos = gap.take();
            if(isChannel.take()) {
                if(pos > 0) {
                    Task<string> target = spawn StringSliceRaw(trimmed, 0, pos);
                    Task<string> why = spawn StringSliceRaw(trimmed, pos + 1,
                                                           len(trimmed) - pos - 1);
                    room = target.take();
                    reason = why.take();
                } else {
                    room = cat(trimmed, "");
                }
            } else {
                room = cat(channel, "");
                reason = cat(trimmed, "");
            }
            argline.dispose();
            trimmed.dispose();
            Task<bool> valid = spawn IrcValidTargetRaw(room);
            if(!valid.take() || len(room) == 0) {
                room.dispose();
                reason.dispose();
                return false;
            }
            Task<string> reasonTask = spawn IrcStripColonRaw(reason);
            reason.dispose();
            reason = reasonTask.take();
            string request = cat("PART ", room);
            if(len(reason) > 0) {
                string withReason = cat(cat(request, " :"), reason);
                request.dispose();
                request = withReason;
            }
            bool ok = enqueueLine(request);
            request.dispose();
            if(ok) {
                Task<string> encoded = spawn IrcViewKeyRaw(room);
                string key = cat("channels/", encoded.take());
                if(joined.Has(key)) { joined[key] = "no"; }
                key.dispose();
                if(cmp(room, channel) == 0) {
                    channel.dispose();
                    activeKey.dispose();
                    activeTarget.dispose();
                    channel = "";
                    activeKey = "";
                    activeTarget = "";
                }
            }
            room.dispose();
            reason.dispose();
            return ok;
        }
        if(wantTopic != 0) {
            Task<string> args = spawn StringSliceRaw(input, 6, len(input) - 6);
            string argline = args.take();
            string room = "";
            string text = "";
            Task<int64> gap = spawn StringIndexOfRaw(argline, " ");
            int64 pos = gap.take();
            Task<bool> looksChannel = spawn IrcIsChannelRaw(argline);
            if(looksChannel.take()) {
                if(pos > 0) {
                    Task<string> target = spawn StringSliceRaw(argline, 0, pos);
                    Task<string> value = spawn StringSliceRaw(argline, pos + 1,
                                                             len(argline) - pos - 1);
                    room = target.take();
                    text = value.take();
                } else {
                    room = cat(argline, "");
                    text = "";
                }
            } else {
                room = cat(channel, "");
                text = cat(argline, "");
            }
            argline.dispose();
            if(len(room) == 0) {
                room.dispose();
                text.dispose();
                return false;
            }
            Task<string> textTask = spawn IrcStripColonRaw(text);
            text.dispose();
            text = textTask.take();
            string request = cat("TOPIC ", room);
            if(len(text) > 0) {
                string withText = cat(cat(request, " :"), text);
                request.dispose();
                request = withText;
            }
            bool ok = enqueueLine(request);
            request.dispose();
            room.dispose();
            text.dispose();
            return ok;
        }
        if(wantMode != 0) {
            Task<string> args = spawn StringSliceRaw(input, 5, len(input) - 5);
            string argline = args.take();
            Task<int64> gap = spawn StringIndexOfRaw(argline, " ");
            int64 pos = gap.take();
            string target = "";
            string spec = "";
            if(pos > 0) {
                Task<string> name = spawn StringSliceRaw(argline, 0, pos);
                Task<string> rest = spawn StringSliceRaw(argline, pos + 1,
                                                        len(argline) - pos - 1);
                target = name.take();
                spec = rest.take();
            } else {
                target = cat(argline, "");
                spec = "";
            }
            argline.dispose();
            Task<bool> valid = spawn IrcValidTargetRaw(target);
            if(!valid.take()) {
                target.dispose();
                spec.dispose();
                return false;
            }
            string request = cat("MODE ", target);
            if(len(spec) > 0) {
                string withSpec = cat(cat(request, " "), spec);
                request.dispose();
                request = withSpec;
            }
            bool ok = enqueueLine(request);
            request.dispose();
            target.dispose();
            spec.dispose();
            return ok;
        }
        if(wantKick != 0) {
            Task<string> args = spawn StringSliceRaw(input, 5, len(input) - 5);
            string argline = args.take();
            Task<int64> first = spawn StringIndexOfRaw(argline, " ");
            int64 firstPos = first.take();
            if(firstPos <= 0) {
                argline.dispose();
                return false;
            }
            Task<string> target = spawn StringSliceRaw(argline, 0, firstPos);
            Task<string> restTask = spawn StringSliceRaw(argline, firstPos + 1,
                                                        len(argline) - firstPos - 1);
            string room = target.take();
            string rest = restTask.take();
            argline.dispose();
            Task<int64> second = spawn StringIndexOfRaw(rest, " ");
            int64 secondPos = second.take();
            string victim = rest;
            string reason = "";
            if(secondPos > 0) {
                Task<string> who = spawn StringSliceRaw(rest, 0, secondPos);
                Task<string> why = spawn StringSliceRaw(rest, secondPos + 1,
                                                       len(rest) - secondPos - 1);
                victim = who.take();
                reason = why.take();
            }
            Task<bool> validRoom = spawn IrcValidTargetRaw(room);
            Task<bool> validVictim = spawn IrcValidTargetRaw(victim);
            bool roomOk = validRoom.take();
            bool victimOk = validVictim.take();
            if(!roomOk || !victimOk) {
                room.dispose();
                rest.dispose();
                if(secondPos > 0) { victim.dispose(); }
                reason.dispose();
                return false;
            }
            Task<string> reasonTask = spawn IrcStripColonRaw(reason);
            reason.dispose();
            reason = reasonTask.take();
            string request = cat(cat(cat("KICK ", room), " "), victim);
            if(len(reason) > 0) {
                string withReason = cat(cat(request, " :"), reason);
                request.dispose();
                request = withReason;
            }
            bool ok = enqueueLine(request);
            request.dispose();
            room.dispose();
            rest.dispose();
            if(secondPos > 0) { victim.dispose(); }
            reason.dispose();
            return ok;
        }
        if(wantWhois != 0) {
            Task<string> args = spawn StringSliceRaw(input, 6, len(input) - 6);
            string argline = args.take();
            Task<bool> valid = spawn IrcValidTargetRaw(argline);
            bool allowed = valid.take();
            string request = cat("WHOIS ", argline);
            bool ok = false;
            if(allowed) {
                ok = enqueueLine(request);
            }
            request.dispose();
            argline.dispose();
            return ok;
        }
        if(wantAway != 0 && (len(input) == 4 || awaySep == 32)) {
            Task<string> args = spawn StringSliceRaw(input, 4, len(input) - 4);
            string argline = args.take();
            Task<string> trimmedTask = spawn StringTrimRaw(argline);
            string trimmed = trimmedTask.take();
            string request = "AWAY";
            if(len(trimmed) > 0) {
                string withText = cat(cat(request, " :"), trimmed);
                request.dispose();
                request = withText;
            }
            bool ok = enqueueLine(request);
            request.dispose();
            argline.dispose();
            trimmed.dispose();
            return ok;
        }
        if(wantInvite != 0) {
            Task<string> args = spawn StringSliceRaw(input, 7, len(input) - 7);
            string argline = args.take();
            Task<int64> gap = spawn StringIndexOfRaw(argline, " ");
            int64 pos = gap.take();
            string who = "";
            string room = "";
            if(pos > 0) {
                Task<string> name = spawn StringSliceRaw(argline, 0, pos);
                Task<string> where = spawn StringSliceRaw(argline, pos + 1,
                                                          len(argline) - pos - 1);
                who = name.take();
                room = where.take();
            } else {
                who = cat(argline, "");
            }
            Task<bool> valid = spawn IrcValidTargetRaw(who);
            bool allowed = valid.take();
            string request = cat("INVITE ", who);
            if(len(room) > 0) {
                string withRoom = cat(cat(request, " "), room);
                request.dispose();
                request = withRoom;
            }
            bool ok = false;
            if(allowed) {
                ok = enqueueLine(request);
            }
            request.dispose();
            argline.dispose();
            who.dispose();
            room.dispose();
            return ok;
        }
        if(cmp(input, "quit") == 0) {
            bool ok = enqueueLine("QUIT :leaving");
            shutDownService();
            return ok;
        }
        return false;
    }
}

function IrcWatchdog(string slot, int64 gen) int64 {
    IrcNetwork network = lookup(slot);
    while(true) {
        Task<int64> slept = spawn IrcSleepRaw(5000);
        slept.take();
        int64 keep = network.watchdogTick(gen);
        if(keep == 0) { return 0; }
    }
}

function IrcPump(string slot, string fd, int64 gen) int64 {
    IrcNetwork network = lookup(slot);
    while(true) {
        Task<string> read = spawn IrcReadLineRaw(fd, gen);
        string line = read.take();
        if(len(line) == 0) {
            line.dispose();
            network.linkLost(gen, "connection closed");
            return 0;
        }
        network.markIncoming();
        network.incoming(line);
        line.dispose();
    }
}

// One supervisor owns dial, registration, the read loop, the ping watchdog,
// and teardown. It never exits while the service runs; connect, disconnect,
// and reconnect are requests handled between attempts.
function IrcSupervise(string slot) int64 {
    IrcNetwork network = lookup(slot);
    while(true) {
        if(!network.wantsConnection()) {
            Task<int64> idle = spawn IrcSleepRaw(500);
            idle.take();
        } else if(!network.retryDue()) {
            Task<int64> wait = spawn IrcSleepRaw(250);
            wait.take();
        } else {
            network.beginConnect();
            string address = network.connectionAddress();
            string transport = network.connectionTransport();
            string host = network.connectionHost();
            string trust = network.connectionTrustPath();
            string nick = network.connectionNick();
            string realName = network.connectionName();
            Task<string> dial;
            if(cmp(transport, "tls") == 0) {
                dial = spawn IrcDialTLSRaw(address, host, trust);
            } else {
                dial = spawn NetDialRaw(address);
            }
            string fd = dial.take();
            Task<int64> failed = spawn StringStartsWithRaw(fd, "error:");
            if(failed.take() != 0) {
                Task<string> detail = spawn StringSliceRaw(fd, 6, len(fd) - 6);
                string message = detail.take();
                network.connectionFailed(message);
                message.dispose();
                fd.dispose();
            } else if(len(fd) == 0) {
                network.connectionFailed("dial returned no descriptor");
            } else {
                int64 gen = network.connected(fd);
                Task<bool> registrationNick = spawn IrcSend(fd, cat("NICK ", nick));
                bool nickSent = registrationNick.take();
                string shownName = realName;
                if(len(shownName) == 0) { shownName = nick; }
                bool userSent = false;
                if(nickSent) {
                    Task<bool> registrationUser = spawn IrcSend(fd,
                        cat(cat(cat("USER ", nick), " 0 * :"), shownName));
                    userSent = registrationUser.take();
                }
                if(!nickSent || !userSent) {
                    network.linkLost(gen, "registration write failed");
                } else {
                    Task<int64> watchdog = spawn IrcWatchdog(slot, gen);
                    Task<int64> reader = spawn IrcPump(slot, fd, gen);
                    reader.take();
                    watchdog.take();
                }
                fd.dispose();
            }
            address.dispose();
            transport.dispose();
            host.dispose();
            trust.dispose();
            nick.dispose();
            realName.dispose();
        }
    }
}

class IrcViews {
    ViewController;
    private Dict<string,IrcNetwork> pool;
    private Dict<string,IrcNetwork> networks;
    private Dict<string,string> names;
    private Dict<string,string> used;
    private Dict<string,string> removed;
    private Dict<string,string> supervised;
    private string slotTable;
    private string order;
    private string selected;
    private string historyRoot;
    private string indexPath;
    private int64 historyLimit;

    method IrcViews(IrcNetwork net0, IrcNetwork net1, IrcNetwork net2,
                    IrcNetwork net3, IrcNetwork net4, IrcNetwork net5,
                    IrcNetwork net6, IrcNetwork net7, string root,
                    string firstChannel, string initialNick, string server,
                    string transport, string host, string trust, int64 limit) {
        pool["network0"] = net0;
        pool["network1"] = net1;
        pool["network2"] = net2;
        pool["network3"] = net3;
        pool["network4"] = net4;
        pool["network5"] = net5;
        pool["network6"] = net6;
        pool["network7"] = net7;
        historyRoot = cat(root, "");
        indexPath = cat(historyRoot, "/networks.index");
        historyLimit = limit;
        slotTable = "network0\tdefault\nnetwork1\tslot1\nnetwork2\tslot2\nnetwork3\tslot3\nnetwork4\tslot4\nnetwork5\tslot5\nnetwork6\tslot6\nnetwork7\tslot7\n";
        order = "";
        selected = "default";
        loadIndex();
        Task<int64> slotsTask = spawn StringCountRaw(slotTable, "\n");
        int64 slots = slotsTask.take();
        int64 i = 0;
        while(i < slots) {
            Task<string> rowTask = spawn StringFieldRaw(slotTable, "\n", i);
            string row = rowTask.take();
            Task<string> idTask = spawn StringFieldRaw(row, "\t", 1);
            string id = idTask.take();
            if(len(id) > 0 && hasId(id)) {
                activateExisting(id, firstChannel, initialNick, server, transport,
                                 host, trust);
            }
            id.dispose();
            row.dispose();
            i = i + 1;
        }
        if(!networks.Has("default")) {
            activateExisting("default", firstChannel, initialNick, server,
                             transport, host, trust);
        }
        saveIndex();
    }

    internal method string slotForId(string id) {
        string out = "";
        Task<int64> rowsTask = spawn StringCountRaw(slotTable, "\n");
        int64 rows = rowsTask.take();
        int64 i = 0;
        while(i < rows && len(out) == 0) {
            Task<string> rowTask = spawn StringFieldRaw(slotTable, "\n", i);
            string row = rowTask.take();
            Task<string> slotTask = spawn StringFieldRaw(row, "\t", 0);
            Task<string> idTask = spawn StringFieldRaw(row, "\t", 1);
            string slot = slotTask.take();
            string candidate = idTask.take();
            if(cmp(candidate, id) == 0) { out = cat(slot, ""); }
            slot.dispose();
            candidate.dispose();
            row.dispose();
            i = i + 1;
        }
        return out;
    }

    internal method string idForSlot(string slot) {
        string out = "";
        Task<int64> rowsTask = spawn StringCountRaw(slotTable, "\n");
        int64 rows = rowsTask.take();
        int64 i = 0;
        while(i < rows && len(out) == 0) {
            Task<string> rowTask = spawn StringFieldRaw(slotTable, "\n", i);
            string row = rowTask.take();
            Task<string> slotTask = spawn StringFieldRaw(row, "\t", 0);
            Task<string> idTask = spawn StringFieldRaw(row, "\t", 1);
            string candidate = slotTask.take();
            string id = idTask.take();
            if(cmp(candidate, slot) == 0) { out = cat(id, ""); }
            candidate.dispose();
            id.dispose();
            row.dispose();
            i = i + 1;
        }
        return out;
    }

    internal method bool hasId(string id) {
        bool found = false;
        Task<int64> rowsTask = spawn StringCountRaw(order, "\n");
        int64 rows = rowsTask.take();
        int64 i = 0;
        while(i < rows && !found) {
            Task<string> field = spawn StringFieldRaw(order, "\n", i);
            string value = field.take();
            if(cmp(value, id) == 0) { found = true; }
            value.dispose();
            i = i + 1;
        }
        return found;
    }

    internal method void appendId(string id) {
        if(len(id) > 0 && !hasId(id)) {
            order = cat(order, cat(id, "\n"));
        }
    }

    internal method void loadIndex() {
        Task<int64> ready = spawn FileMkdirAllRaw(historyRoot);
        ready.take();
        Task<string> loaded = spawn IrcHistoryIndexLoadRaw(indexPath);
        string saved = loaded.take();
        Task<int64> rowsTask = spawn StringCountRaw(saved, "\n");
        int64 rows = rowsTask.take();
        int64 i = 0;
        while(i < rows) {
            Task<string> rowTask = spawn StringFieldRaw(saved, "\n", i);
            string row = rowTask.take();
            if(len(row) > 0) {
                Task<string> idTask = spawn StringFieldRaw(row, "\t", 0);
                Task<string> nameTask = spawn StringFieldRaw(row, "\t", 1);
                string id = idTask.take();
                string name = nameTask.take();
                if(len(id) > 0) {
                    appendId(id);
                    if(len(name) == 0) { name = id; }
                    names[id] = name;
                    used[id] = "yes";
                }
                id.dispose();
                name.dispose();
            }
            row.dispose();
            i = i + 1;
        }
        saved.dispose();
        if(!hasId("default")) {
            appendId("default");
            names["default"] = "default";
            used["default"] = "yes";
        }
    }

    internal method void saveIndex() {
        string text = "";
        Task<int64> rowsTask = spawn StringCountRaw(order, "\n");
        int64 rows = rowsTask.take();
        int64 i = 0;
        while(i < rows) {
            Task<string> field = spawn StringFieldRaw(order, "\n", i);
            string id = field.take();
            if(len(id) > 0 && used.Has(id) && cmp(used[id], "yes") == 0 &&
               !(removed.Has(id) && cmp(removed[id], "yes") == 0)) {
                string name = id;
                if(names.Has(id)) { name = names[id]; }
                string line = cat(cat(id, "\t"), cat(name, "\n"));
                string next = cat(text, line);
                text.dispose();
                text = next;
                line.dispose();
            }
            id.dispose();
            i = i + 1;
        }
        Task<bool> saved = spawn IrcHistoryIndexSaveRaw(indexPath, text);
        saved.take();
        text.dispose();
    }

    internal method void activateExisting(string id, string firstChannel,
                                          string nick, string server,
                                          string transport, string host,
                                          string trust) {
        string slot = slotForId(id);
        if(len(slot) > 0 && pool.Has(slot)) {
            IrcNetwork net = pool[slot];
            string display = id;
            if(names.Has(id)) { display = names[id]; }
            net.setNetworkName(display);
            networks[id] = net;
            names[id] = cat(display, "");
            used[id] = "yes";
            appendId(id);
            if(cmp(id, "default") == 0 && len(server) > 0) {
                net.applyTransport(transport, host, trust);
                net.requestConnect();
            } else {
                net.loadStoredProfile();
            }
            if(!(supervised.Has(slot) && cmp(supervised[slot], "yes") == 0)) {
                supervised[slot] = "yes";
                Task<int64> supervisor = spawn IrcSupervise(slot);
            }
        }
        slot.dispose();
    }

    internal method bool addNetwork(string profile) {
        Task<bool> valid = spawn IrcProfileValidRaw(profile);
        if(!valid.take()) { return false; }
        Task<string> hostField = spawn StringFieldRaw(profile, "\t", 0);
        Task<string> nameField = spawn StringFieldRaw(profile, "\t", 4);
        string host = hostField.take();
        string display = nameField.take();
        if(len(display) == 0) {
            display.dispose();
            display = cat(host, "");
        }
        string chosenId = "";
        string chosenSlot = "";
        Task<int64> rowsTask = spawn StringCountRaw(slotTable, "\n");
        int64 rows = rowsTask.take();
        int64 i = 0;
        while(i < rows && len(chosenId) == 0) {
            Task<string> rowTask = spawn StringFieldRaw(slotTable, "\n", i);
            string row = rowTask.take();
            Task<string> slotTask = spawn StringFieldRaw(row, "\t", 0);
            Task<string> idTask = spawn StringFieldRaw(row, "\t", 1);
            string slot = slotTask.take();
            string id = idTask.take();
            bool busy = used.Has(id) && cmp(used[id], "yes") == 0;
            bool everStarted = supervised.Has(id) && cmp(supervised[id], "yes") == 0;
            if(!busy && !everStarted && len(id) > 0) {
                chosenId = cat(id, "");
                chosenSlot = cat(slot, "");
                removed[id] = "no";
            }
            slot.dispose();
            id.dispose();
            row.dispose();
            i = i + 1;
        }
        bool ok = false;
        if(len(chosenId) > 0 && pool.Has(chosenSlot)) {
            IrcNetwork net = pool[chosenSlot];
            ok = net.configure(profile, true);
            if(ok) {
                net.setNetworkName(display);
                networks[chosenId] = net;
                names[chosenId] = cat(display, "");
                used[chosenId] = "yes";
                appendId(chosenId);
                selected.dispose();
                selected = cat(chosenId, "");
                if(!(supervised.Has(chosenSlot) && cmp(supervised[chosenSlot], "yes") == 0)) {
                    supervised[chosenSlot] = "yes";
                    Task<int64> supervisor = spawn IrcSupervise(chosenSlot);
                }
                saveIndex();
            }
        } else {
            ok = false;
        }
        host.dispose();
        display.dispose();
        chosenId.dispose();
        chosenSlot.dispose();
        return ok;
    }

    internal method bool removeNetwork(string id) {
        bool ok = false;
        if(cmp(id, "default") != 0 && networks.Has(id)) {
            IrcNetwork net = networks[id];
            net.markRemoved();
            used[id] = "no";
            removed[id] = "yes";
            if(cmp(selected, id) == 0) {
                selected.dispose();
                selected = "default";
            }
            saveIndex();
            ok = true;
        }
        return ok;
    }

    internal method bool renameNetwork(string id, string display) {
        bool ok = false;
        if(networks.Has(id) && len(display) > 0) {
            IrcNetwork net = networks[id];
            net.setNetworkName(display);
            names[id] = cat(display, "");
            saveIndex();
            ok = true;
        }
        return ok;
    }

    internal method bool selectNetwork(string id) {
        bool ok = false;
        if(networks.Has(id)) {
            selected.dispose();
            selected = cat(id, "");
            ok = true;
        }
        return ok;
    }

    internal method bool networkCommand(string input) {
        Task<int64> add = spawn StringStartsWithRaw(input, "add\t");
        Task<int64> remove = spawn StringStartsWithRaw(input, "remove\t");
        Task<int64> rename = spawn StringStartsWithRaw(input, "rename\t");
        Task<int64> select = spawn StringStartsWithRaw(input, "select\t");
        bool ok = false;
        if(add.take() != 0) {
            Task<string> fields = spawn StringSliceRaw(input, 4, len(input) - 4);
            string profile = fields.take();
            ok = addNetwork(profile);
            profile.dispose();
        } else if(remove.take() != 0) {
            Task<string> fields = spawn StringSliceRaw(input, 7, len(input) - 7);
            string id = fields.take();
            ok = removeNetwork(id);
            id.dispose();
        } else if(rename.take() != 0) {
            Task<string> fields = spawn StringSliceRaw(input, 7, len(input) - 7);
            string args = fields.take();
            Task<int64> gap = spawn StringIndexOfRaw(args, "\t");
            int64 pos = gap.take();
            if(pos > 0) {
                Task<string> idField = spawn StringSliceRaw(args, 0, pos);
                Task<string> nameField = spawn StringSliceRaw(args, pos + 1,
                                                            len(args) - pos - 1);
                string id = idField.take();
                string name = nameField.take();
                ok = renameNetwork(id, name);
                id.dispose();
                name.dispose();
            }
            args.dispose();
        } else if(select.take() != 0) {
            Task<string> fields = spawn StringSliceRaw(input, 7, len(input) - 7);
            string id = fields.take();
            ok = selectNetwork(id);
            id.dispose();
        }
        return ok;
    }

    internal method FileTree display(string id, string caller) {
        FileTree root = new FileTree();
        root.dir("networks");
        root.live("network", true);
        root.live("networks.list", false);
        root.live("selected", true);
        MountTable mounts = new MountTable();
        Task<int64> rowsTask = spawn StringCountRaw(slotTable, "\n");
        int64 rows = rowsTask.take();
        int64 i = 0;
        while(i < rows) {
            Task<string> rowTask = spawn StringFieldRaw(slotTable, "\n", i);
            string row = rowTask.take();
            Task<string> idTask = spawn StringFieldRaw(row, "\t", 1);
            string networkId = idTask.take();
            if(len(networkId) > 0) {
                string prefix = cat("networks/", networkId);
                root.dir(prefix);
                root.live(cat(prefix, "/input"), true);
                root.live(cat(prefix, "/connect"), true);
                root.live(cat(prefix, "/disconnect"), true);
                mounts.view(prefix, cat("o9irc.network.", networkId), 1);
                prefix.dispose();
            }
            networkId.dispose();
            row.dispose();
            i = i + 1;
        }
        root.apply(mounts);
        mounts.close();
        return root;
    }

    internal method string networkListText() {
        string text = "";
        Task<int64> rowsTask = spawn StringCountRaw(slotTable, "\n");
        int64 rows = rowsTask.take();
        int64 i = 0;
        while(i < rows) {
            Task<string> rowTask = spawn StringFieldRaw(slotTable, "\n", i);
            string row = rowTask.take();
            Task<string> idTask = spawn StringFieldRaw(row, "\t", 1);
            string id = idTask.take();
            if(len(id) > 0 && networks.Has(id) && used.Has(id) &&
               cmp(used[id], "yes") == 0 &&
               !(removed.Has(id) && cmp(removed[id], "yes") == 0)) {
                IrcNetwork net = networks[id];
                string name = net.networkName();
                string address = net.connectionAddress();
                string status = net.networkStatus();
                string line = cat(cat(cat(id, "\t"), cat(name, "\t")),
                                  cat(cat(address, "\t"), cat(status, "\n")));
                string next = cat(text, line);
                text.dispose();
                text = next;
                line.dispose();
                name.dispose();
                address.dispose();
                status.dispose();
            }
            id.dispose();
            row.dispose();
            i = i + 1;
        }
        return text;
    }

    internal method string readText(string id, string path) {
        string out = "";
        if(cmp(path, "networks.list") == 0) {
            out = networkListText();
        } else if(cmp(path, "selected") == 0) {
            out = cat(selected, "\n");
        }
        return out;
    }

    internal method int64 writeText(string id, string path, int64 offset,
                                    string text, bool truncate) {
        if(offset != 0) { return -1; }
        string input = text;
        bool ownsInput = false;
        Task<int64> endsNewline = spawn StringEndsWithRaw(input, "\n");
        if(endsNewline.take() != 0) {
            Task<string> trimmed = spawn StringSliceRaw(input, 0, len(input) - 1);
            input = trimmed.take();
            ownsInput = true;
        }
        bool accepted = false;
        if(cmp(path, "network") == 0) {
            accepted = networkCommand(input);
        } else if(cmp(path, "selected") == 0) {
            accepted = selectNetwork(input);
        } else {
            Task<int64> prefix = spawn StringStartsWithRaw(path, "networks/");
            if(prefix.take() != 0) {
                Task<string> restTask = spawn StringSliceRaw(path, 9,
                                                             len(path) - 9);
                string rest = restTask.take();
                Task<int64> slash = spawn StringIndexOfRaw(rest, "/");
                int64 pos = slash.take();
                if(pos > 0) {
                    Task<string> idTask = spawn StringSliceRaw(rest, 0, pos);
                    Task<string> leafTask = spawn StringSliceRaw(rest, pos + 1,
                                                                len(rest) - pos - 1);
                    string networkId = idTask.take();
                    string leaf = leafTask.take();
                    if(networks.Has(networkId)) {
                        IrcNetwork net = networks[networkId];
                        if(cmp(leaf, "input") == 0) {
                            accepted = net.command(input);
                        } else if(cmp(leaf, "connect") == 0) {
                            net.requestConnect();
                            accepted = true;
                        } else if(cmp(leaf, "disconnect") == 0) {
                            net.requestDisconnect();
                            accepted = true;
                        }
                    }
                    networkId.dispose();
                    leaf.dispose();
                }
                rest.dispose();
            }
        }
        if(ownsInput) { input.dispose(); }
        if(accepted) { return len(text); }
        return -1;
    }
}

main {
    Task<int64> count = spawn ProcessArgcRaw();
    int64 argTotal = count.take();
    // Three arguments (program, service name) is the idle service used by
    // the GUI launcher.  An address without a nick is never usable.
    if(argTotal < 3 || argTotal == 4) {
        print("usage: ircfs ircfs [tcp!host!6667|tls!host!6697 nick [#channel [historydir [limit [trustedkeys]]]]]\n");
    } else {
        string address = "";
        string nick = "";
        if(argTotal >= 4) {
        Task<string> addressArg = spawn ProcessArgRaw(2);
        Task<string> nickArg = spawn ProcessArgRaw(3);
            address = addressArg.take();
            nick = nickArg.take();
        }
        string channel = "";
        if(argTotal > 4) {
            Task<string> channelArg = spawn ProcessArgRaw(4);
            channel = channelArg.take();
        }
        Task<string> currentUser = spawn ProcessUserRaw();
        string historyDirectory = cat(cat("/usr/", currentUser.take()), "/lib/o9irc");
        if(argTotal > 5) {
            Task<string> dirArg = spawn ProcessArgRaw(5);
            historyDirectory = dirArg.take();
        }
        string limitArg = "";
        if(argTotal > 6) {
            Task<string> maxArg = spawn ProcessArgRaw(6);
            limitArg = maxArg.take();
        }
        string transport = "tcp";
        string serverName = "";
        string trustFile = "";
        Task<int64> secureAddress = spawn StringStartsWithRaw(address, "tls!");
        if(secureAddress.take() != 0) {
            transport = "tls";
            Task<string> hostField = spawn StringFieldRaw(address, "!", 1);
            Task<string> portField = spawn StringFieldRaw(address, "!", 2);
            serverName = hostField.take();
            string securePort = portField.take();
            address = cat(cat(cat("tcp!", serverName), "!"), securePort);
            if(argTotal > 7) {
                Task<string> trustArg = spawn ProcessArgRaw(7);
                trustFile = trustArg.take();
            }
        }
        Task<int64> limit = spawn IrcHistoryLimitRaw(limitArg);
        int64 historyLimit = limit.take();
        string slotRoot = cat(historyDirectory, "/networks");
        IrcNetwork network0 = new IrcNetwork("default", channel, nick, address,
                                             historyDirectory, historyLimit);
        IrcNetwork network1 = new IrcNetwork("slot1", "", "", "",
            cat(slotRoot, "/slot1"), historyLimit);
        IrcNetwork network2 = new IrcNetwork("slot2", "", "", "",
            cat(slotRoot, "/slot2"), historyLimit);
        IrcNetwork network3 = new IrcNetwork("slot3", "", "", "",
            cat(slotRoot, "/slot3"), historyLimit);
        IrcNetwork network4 = new IrcNetwork("slot4", "", "", "",
            cat(slotRoot, "/slot4"), historyLimit);
        IrcNetwork network5 = new IrcNetwork("slot5", "", "", "",
            cat(slotRoot, "/slot5"), historyLimit);
        IrcNetwork network6 = new IrcNetwork("slot6", "", "", "",
            cat(slotRoot, "/slot6"), historyLimit);
        IrcNetwork network7 = new IrcNetwork("slot7", "", "", "",
            cat(slotRoot, "/slot7"), historyLimit);
        IrcViews views = new IrcViews(network0, network1, network2, network3,
                                      network4, network5, network6, network7,
                                      historyDirectory, channel, nick, address,
                                      transport, serverName, trustFile,
                                      historyLimit);
        viewController(views);
        serve();
    }
}
